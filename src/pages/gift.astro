---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import GiftIntro from '../components/gift/GiftIntro.astro';
import GiftCard from '../components/gift/GiftCard.astro';
import GiftOrder from '../components/gift/GiftOrder.astro';
import BookingContact from '../components/booking/BookingContact.astro';
import BookingLegal from '../components/booking/BookingLegal.astro';
---

<Base
  title="Natalie — Geef een moment cadeau"
  description="Een cadeaubon voor een klankervaring in een geometrische ruimte in het bos. Voor 1 tot 3 personen, zonder leeftijd."
  tint="#F5F1E9"
>
  <div class="page">
    <SiteHeader href="/" tone="dark">←&nbsp;Terug</SiteHeader>
    <!-- One calm column, like the booking page: the intro, the voucher, the choice and how to order, contact. -->
    <main class="layout">
      <GiftIntro />
      <GiftCard />
      <GiftOrder />
      <div data-rise style="--i: 8"><BookingContact /><BookingLegal /></div>
    </main>
  </div>
</Base>

<script>
  import { initGift } from '../scripts/gift';
  initGift();
</script>

<style>
  .page {
    position: relative;
    min-height: 100svh;
    background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-warm) 50%, var(--color-ivory) 100%);
    color: var(--color-bronze-900);
  }
  .layout {
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(120px, 16vh, 170px) 24px 80px;
  }
  @media (max-width: 600px) {
    .layout {
      gap: 36px;
      padding: 96px 16px 56px;
    }
  }
</style>
