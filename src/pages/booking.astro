---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BookingIntro from '../components/booking/BookingIntro.astro';
import BookingSteps from '../components/booking/BookingSteps.astro';
import BookingContact from '../components/booking/BookingContact.astro';
import BookingLegal from '../components/booking/BookingLegal.astro';
---

<Base
  title="Afspraak maken — Soundroom en coaching in Schoten · Natalie Van der Voort"
  description="Kies je sessie: de soundroom (€35, 50 minuten, tot 3 personen) of coaching met Natalie (€65). Kies je muziek en boek een moment in de agenda."
  tint="#F5F1E9"
>
  <div class="page">
    <SiteHeader href="/" tone="dark">←&nbsp;Terug</SiteHeader>
    <!-- One calm column on every screen: the intro, then the three steps, then contact. -->
    <main class="layout">
      <BookingIntro />
      <BookingSteps />
      <div data-rise style="--i: 7"><BookingContact /><BookingLegal /></div>
    </main>
  </div>
</Base>

<script>
  import { initBooking } from '../scripts/booking';
  initBooking();
</script>

<style>
  .page {
    position: relative;
    min-height: 100svh;
    background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-warm) 50%, var(--color-ivory) 100%);
    color: var(--color-bronze-900);
  }
  .layout {
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(120px, 16vh, 170px) 24px 80px;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
  @media (max-width: 600px) {
    .layout {
      gap: 36px;
      padding: 96px 16px 56px;
    }
  }
</style>
