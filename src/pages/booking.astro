---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BookingVisual from '../components/booking/BookingVisual.astro';
import Sessions from '../components/booking/Sessions.astro';
import People from '../components/booking/People.astro';
import BookingCalendar from '../components/booking/BookingCalendar.astro';
import GoodToKnow from '../components/booking/GoodToKnow.astro';
---

<Base
  title="Afspraak maken — Natalie"
  description="Plan een moment in de koepel: immersieve muziek en persoonlijke begeleiding bij Natalie Vandervoort."
  tint="#120A05"
  tintLight="#F5F1E9"
>
  <div class="page">
    <SiteHeader base="/" />
    <BookingVisual />
    <main class="flow">
      <Sessions />
      <People />
      <BookingCalendar />
      <GoodToKnow />
    </main>
  </div>
</Base>

<style>
  /* Mobile first: one calm column. Wider screens keep the same column, centered;
     only the calendar gets more room (BookingCalendar). */
  .page {
    min-height: 100svh;
    background: var(--page-booking);
    color: var(--fg);
  }
  .flow {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 28px 24px 56px;
  }
  @media (min-width: 700px) {
    .flow {
      width: min(560px, 100%);
      margin: 0 auto;
      gap: 44px;
      padding: 40px 0 80px;
    }
  }
</style>
