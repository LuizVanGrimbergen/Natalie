---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Sessions from '../components/booking/Sessions.astro';
import People from '../components/booking/People.astro';
import BookingCalendar from '../components/booking/BookingCalendar.astro';
import GoodToKnow from '../components/booking/GoodToKnow.astro';
import photo from '../assets/booking.avif';
---

<Base
  title="Afspraak maken — Natalie Vandervoort"
  description="Boek een soundroom-sessie of een coachingsessie bij Natalie Vandervoort in Schoten: 50 minuten, alleen of met vrienden."
  tint="#120A05"
>
  <div class="page">
    <SiteHeader base="/" />
    <PhotoBand photo={photo} title="Afspraak" facts="50 minuten · Schoten · vanaf 18 jaar" focus="38% 28%">
      <Fragment slot="accent">maken</Fragment>
    </PhotoBand>
    <main class="flow">
      <Sessions />
      <People />
      <BookingCalendar />
      <GoodToKnow />
    </main>
  </div>
</Base>

<style>
  /* Mobile first: one calm column. Wider screens keep the same column, centered;
     only the calendar gets more room (BookingCalendar). */
  .page {
    min-height: 100svh;
    background: var(--page-booking);
    color: var(--fg);
  }
  .flow {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 28px 24px 56px;
  }
  /* The parts rise one after the other, under the photo's title. */
  .flow > :global(*) {
    animation: flow-rise 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) backwards;
    animation-delay: calc(0.6s + var(--i, 0) * 0.12s);
  }
  .flow > :global(:nth-child(2)) { --i: 1; }
  .flow > :global(:nth-child(3)) { --i: 2; }
  .flow > :global(:nth-child(4)) { --i: 3; }
  .flow > :global(:nth-child(5)) { --i: 4; }
  @keyframes flow-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @media (min-width: 700px) {
    .flow {
      width: min(560px, 100%);
      margin: 0 auto;
      gap: 44px;
      padding: 40px 0 80px;
    }
  }
</style>
