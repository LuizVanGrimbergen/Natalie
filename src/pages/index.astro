---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import NextCue from '../components/NextCue.astro';
import ProgressRail from '../components/ProgressRail.astro';
import SoundToggle from '../components/SoundToggle.astro';
import BookPill from '../components/BookPill.astro';
import Hero from '../components/scenes/Hero.astro';
import Listening from '../components/scenes/Listening.astro';
import Perspectives from '../components/scenes/Perspectives.astro';
import WhoWelcomes from '../components/scenes/WhoWelcomes.astro';
import Invitation from '../components/scenes/Invitation.astro';
import hero from '../assets/hero.avif';

// Same widths/sizes as the hero <Image>, so the preload is reused.
const heroPreload = await getImage({ src: hero, widths: [800, 1200, 1600], sizes: '100vw', format: 'avif', quality: 38 });
---

<Base
  story
  title="Natalie Van der Voort — Soundroom en coaching in het bos, Schoten"
  description="Vijftig minuten muziek die je van alle kanten omringt, in een geometrisch ruimteschip in het bos in Schoten. Alleen, of met begeleiding van Natalie (coaching, 18 tot 35 jaar)."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPreload.src}
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes="100vw"
    type="image/avif"
    fetchpriority="high"
  />

  <SiteHeader href="#invitation">Kom het zelf ontdekken&nbsp;→</SiteHeader>

  <main>
    <Hero />
    <Listening />
    <Perspectives />
    <WhoWelcomes />
    <Invitation />
  </main>

  <NextCue />
  <ProgressRail />
  <SoundToggle />
  <BookPill />
</Base>

<script>
  import { initScenes } from '../scripts/scenes';
  import { initSound } from '../scripts/sound';
  import { initBookStatic } from '../scripts/scenes/book';
  if (document.documentElement.classList.contains('motion')) initScenes();
  else initBookStatic();
  initSound();
</script>
