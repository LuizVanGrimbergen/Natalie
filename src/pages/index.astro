---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import NextCue from '../components/NextCue.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/scenes/Hero.astro';
import Shape from '../components/scenes/Shape.astro';
import Listening from '../components/scenes/Listening.astro';
import Elements from '../components/scenes/Elements.astro';
import Coaching from '../components/scenes/Coaching.astro';
import WhoWelcomes from '../components/scenes/WhoWelcomes.astro';
import Invitation from '../components/scenes/Invitation.astro';
import hero from '../assets/hero.avif';

// Same widths/sizes as the hero <Image>, so the preload is reused.
const heroPreload = await getImage({ src: hero, widths: [800, 1200, 1448], sizes: '100vw', format: 'avif' });
---

<Base
  story
  tintLight="#6B4A36"
  title="Natalie — Niet alles wat je raakt, kun je meteen begrijpen."
  description="Tot rust komen in immersieve muziek, in een geometrische koepel in het bos, en persoonlijke coaching bij Natalie Vandervoort. Een plek om je eigen perspectief te ontdekken."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPreload.src}
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes="100vw"
    type="image/avif"
    fetchpriority="high"
  />

  <SiteHeader />

  <main>
    <Hero />
    <Shape />
    <Listening />
    <Elements />
    <Coaching />
    <WhoWelcomes />
    <Invitation />
  </main>

  <NextCue />
  <SiteFooter />
</Base>

<script>
  import { initScenes } from '../scripts/scenes';
  if (document.documentElement.classList.contains('motion')) initScenes();
</script>
