---
/**
 * One research piece: the photo band with its title, then one calm reading column
 * in the page's own color (follows the theme), and a way back to the list and to booking.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import CtaLink from '../../components/CtaLink.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import photo from '../../assets/interior.avif';
import { formatDate } from '../../components/research/date';

export async function getStaticPaths() {
  const pieces = await getCollection('research', ({ data }) => !data.draft);
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
const { title, accent, date, summary } = piece.data;
const home = new URL('/', Astro.site).href;
const article = {
  '@type': 'Article',
  headline: `${title} ${accent}`,
  description: summary,
  datePublished: date.toISOString(),
  inLanguage: 'nl-BE',
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@id': `${home}#natalie` },
  publisher: { '@id': `${home}#business` },
};
---

<Base title={`${title} ${accent} — Natalie Vandervoort`} description={summary} tint="#120A05" ogType="article" schema={[article]}>
  <div class="page">
    <SiteHeader base="/" />
    <PhotoBand photo={photo} title={title} facts={`Onderzoek · ${formatDate(date)}`} focus="50% 40%">
      <Fragment slot="accent">{accent}</Fragment>
    </PhotoBand>
    <main class="piece">
      <article class="prose">
        <Content />
      </article>
      <nav class="piece__end" aria-label="Verder">
        <CtaLink href="/booking">Ervaar de ruimte zelf</CtaLink>
        <a class="piece__back" href="/onderzoek">← Alle onderzoek</a>
      </nav>
    </main>
    <SiteFooter />
  </div>
</Base>

<style>
  .page {
    min-height: 100svh;
    background: var(--page);
    color: var(--fg);
  }
  .piece {
    width: min(680px, 100%);
    margin: 0 auto;
    padding: 32px 24px 72px;
    animation: piece-rise 0.9s 0.6s cubic-bezier(0.2, 0.6, 0.2, 1) backwards;
  }
  @keyframes piece-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .prose {
    font-size: 16px;
    line-height: 1.75;
    color: var(--fg-soft);
  }
  .prose :global(p + p) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    margin: 2.2em 0 0.6em;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  /* The first paragraph opens a little larger. */
  .prose > :global(p:first-child) {
    font-size: 1.12em;
    color: var(--fg);
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .piece__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .piece__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .piece__back:hover,
  .piece__back:focus-visible {
    color: var(--fg);
  }
  @media (min-width: 700px) {
    .prose {
      font-size: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece {
      animation: none;
    }
  }
</style>
