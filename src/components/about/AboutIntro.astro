---
// The top of Natalie's story: her name, the title, then the soundroom in the autumn forest (her photo of November).
import { Picture } from 'astro:assets';
import domeAutumn from '../../assets/dome-autumn.jpg';
---

<header class="intro">
  <p class="label intro__label" data-rise style="--i: 0">Natalie Van der Voort</p>
  <h1 class="display intro__h" data-rise style="--i: 1">Mijn <em>verhaal</em></h1>
  <figure class="intro__photo" data-rise style="--i: 2">
    <Picture
      class="intro__img"
      src={domeAutumn}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      alt="Het ruimteschip met koperen panelen tussen de herfstbomen, de trap naar de ingang vol bladeren"
      widths={[640, 960, 1200]}
      sizes="(max-width: 600px) calc(100vw - 40px), 640px"
      loading="eager"
    />
  </figure>
</header>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .intro__label {
    color: var(--color-copper-700);
  }
  .intro__h {
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.95;
  }
  .intro__h em {
    color: var(--color-copper-700);
  }
  /* As wide as the reading column: text and photos share one edge. */
  .intro__photo {
    width: 100%;
    margin-top: 34px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(62 52 44 / 0.45);
  }
  .intro__photo :global(.intro__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
  }
  @media (max-width: 600px) {
    /* Taller on a phone, so the whole room fits. */
    .intro__photo {
      margin-top: 24px;
      aspect-ratio: 4 / 5;
      box-shadow: none;
    }
  }
</style>
