---
// The top of Natalie's story: her name, the title, and the room in the forest as the first image.
import { Picture } from 'astro:assets';
import hero from '../../assets/hero.avif';
---

<header class="intro">
  <p class="label intro__label" data-rise style="--i: 0">Natalie Van der Voort</p>
  <h1 class="display intro__h" data-rise style="--i: 1">Mijn <em>verhaal</em></h1>
  <figure class="intro__photo" data-rise style="--i: 2">
    <Picture
      class="intro__img"
      src={hero}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      alt="Het houten ruimteschip tussen de bomen in het bos"
      widths={[640, 960, 1280]}
      sizes="(max-width: 600px) 100vw, 880px"
      loading="eager"
    />
  </figure>
</header>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .intro__label {
    color: var(--color-copper-700);
  }
  .intro__h {
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.95;
  }
  .intro__h em {
    color: var(--color-copper-700);
  }
  /* Wider than the reading column, so the page opens on the place itself. */
  .intro__photo {
    width: min(880px, calc(100vw - 48px));
    margin: 34px 0 0 50%;
    transform: translateX(-50%);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(62 52 44 / 0.45);
  }
  .intro__photo :global(.intro__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 55%;
  }
  @media (max-width: 600px) {
    /* Edge to edge on a phone. */
    .intro__photo {
      width: 100vw;
      margin-top: 24px;
      aspect-ratio: 4 / 3;
      box-shadow: none;
    }
  }
</style>
