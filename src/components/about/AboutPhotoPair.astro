---
// Two photos side by side inside a chapter (the build): as wide as the text, stacked on small phones.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; alt: string; position?: string }[];
}
const { photos } = Astro.props;
---

<div class="pair">
  {
    photos.map((photo) => (
      <figure class="pair__photo">
        <Picture
          class="pair__img"
          src={photo.src}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          alt={photo.alt}
          widths={[360, 720].filter((w) => w <= photo.src.width).concat(photo.src.width < 360 ? [photo.src.width] : [])}
          sizes="(max-width: 420px) calc(100vw - 40px), 320px"
          style={photo.position ? `object-position: ${photo.position}` : undefined}
        />
      </figure>
    ))
  }
</div>

<style>
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 18px 0;
  }
  .pair__photo {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    box-shadow: 0 30px 60px -36px rgb(62 52 44 / 0.45);
  }
  .pair__photo :global(.pair__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 420px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
