---
/**
 * One chapter of Natalie's story: a small label with the years, a title, and her paragraphs (the slot).
 * The first chapter opens with a copper initial. Each chapter rises softly as it scrolls into view (CSS only,
 * where the browser supports scroll-driven animations; otherwise it is simply there).
 */
interface Props {
  id: string;
  label: string;
  title: string;
  first?: boolean;
}
const { id, label, title, first = false } = Astro.props;
---

<section class:list={['chapter', { 'chapter--first': first }]} aria-labelledby={id}>
  <p class="label chapter__label">{label}</p>
  <h2 id={id} class="chapter__title">{title}</h2>
  <div class="chapter__text"><slot /></div>
</section>

<style>
  .chapter {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .chapter__label {
    font-variant-numeric: lining-nums;
    color: var(--color-copper-700);
  }
  .chapter__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-bronze-900);
  }
  .chapter__text {
    display: flex;
    flex-direction: column;
    gap: 1.1em;
    margin-top: 10px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--color-body-on-ivory);
  }
  /* The story opens with a large copper initial. */
  .chapter--first .chapter__text > :global(p:first-child)::first-letter {
    float: left;
    margin: 0.08em 0.1em 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 4.4em;
    line-height: 0.8;
    color: var(--color-copper-700);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .chapter {
        animation: chapter-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }
  @keyframes chapter-in {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @media (max-width: 600px) {
    .chapter__text {
      font-size: 16px;
      line-height: 1.75;
    }
  }
</style>
