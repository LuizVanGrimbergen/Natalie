---
/**
 * Lets a full-screen photo fade into one flat color at its top and bottom
 * edge. Safari paints its bars (around the camera and the toolbar) in a single
 * color, so a photo scene only meets them seamlessly when its edges are that
 * color too. `color` must equal the scene's data-tint.
 */
interface Props {
  color: string;
}
const { color } = Astro.props;
---

<div class="edge edge--top" style={`--edge: ${color}`} aria-hidden="true"></div>
<div class="edge edge--bottom" style={`--edge: ${color}`} aria-hidden="true"></div>

<style>
  .edge {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    /* Eased stops, so the photo dissolves instead of ending in a visible band. */
    --edge-fade: var(--edge) 0%, color-mix(in srgb, var(--edge) 82%, transparent) 22%,
      color-mix(in srgb, var(--edge) 50%, transparent) 50%, color-mix(in srgb, var(--edge) 18%, transparent) 78%, transparent 100%;
  }
  .edge--top {
    top: 0;
    height: 16svh;
    background: linear-gradient(to bottom, var(--edge-fade));
  }
  /* The stage runs under Safari's bottom toolbar (100lvh); below the visible
     screen (100svh) the color is flat, above it the photo fades in. */
  .edge--bottom {
    bottom: 0;
    height: calc(100lvh - 100svh + 16svh);
    background:
      linear-gradient(to top, var(--edge-fade)) top / 100% 16svh no-repeat,
      linear-gradient(var(--edge), var(--edge)) bottom / 100% calc(100lvh - 100svh) no-repeat;
  }
</style>
