---
/**
 * Where you are in the story, and a way to jump: one dot per screen on the right
 * edge, a small pill that glides to the screen on show. Screens already seen stay
 * full, the ones still to come are faint. scripts/scenes/progress.ts builds the
 * dots (one button per scene) and moves the pill with each step.
 */
---

<nav class="rail" data-rail aria-label="Schermen">
  <span class="rail__pill" data-rail-pill aria-hidden="true"></span>
</nav>

<style>
  .rail {
    --dot: 4px;
    /* Each dot is a 44px wide button; the pitch keeps them easy to hit. */
    --pitch: 28px;
    position: fixed;
    right: 10px;
    top: 50%;
    z-index: 20;
    display: flex;
    flex-direction: column;
    color: var(--color-sand);
    translate: 0 -50%;
    opacity: 0;
    transition:
      opacity 0.8s ease,
      color 0.9s ease;
  }
  .rail.is-light {
    color: var(--color-bronze-900);
  }
  :global(html:not(.motion)) .rail {
    display: none;
  }
  .rail.is-ready {
    opacity: 1;
  }
  .rail :global(.rail__dot) {
    display: grid;
    place-items: center;
    width: 44px;
    height: var(--pitch);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .rail :global(.rail__dot)::before {
    content: '';
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: currentColor;
    opacity: 0.32;
    transition:
      opacity 0.9s ease,
      transform 0.3s ease;
  }
  .rail :global(.rail__dot.is-seen)::before {
    opacity: 0.85;
  }
  @media (hover: hover) {
    .rail :global(.rail__dot:hover)::before {
      opacity: 1;
      transform: scale(1.6);
    }
  }
  .rail :global(.rail__dot:focus-visible) {
    outline: 2px solid var(--color-copper-300);
    outline-offset: -6px;
    border-radius: 999px;
  }
  /* The pill sits over the dot on show; it glides with the crossfade (0.9s, like FADE). */
  .rail__pill {
    position: absolute;
    left: calc(22px - var(--dot));
    top: calc(var(--pitch) / 2 - var(--dot) * 2);
    width: calc(var(--dot) * 2);
    height: calc(var(--dot) * 4);
    border: 1px solid currentColor;
    border-radius: 999px;
    pointer-events: none;
    transform: translateY(calc(var(--at, 0) * var(--pitch)));
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Phones: smaller and closer to the edge, clear of the text (which keeps 24px). */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .rail {
      --dot: 3px;
      --pitch: 24px;
      right: -12px;
    }
  }
</style>
