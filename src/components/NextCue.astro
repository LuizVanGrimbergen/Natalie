---
/**
 * "There is more", without words: a mouse whose wheel rolls down (pointer) or two
 * chevrons that light up one after the other (touch). navigation.ts shows it once a
 * screen is complete and hides it on the next step; clicking it is a step too.
 */
---

<button class="next" type="button" data-next aria-label="Naar het volgende scherm">
  <span class="next__mouse" aria-hidden="true"><span class="next__wheel"></span></span>
  <svg class="next__chevrons" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="next__chevron" d="M6 6.5 L12 12 L18 6.5"></path>
    <path class="next__chevron next__chevron--2" d="M6 12.5 L12 18 L18 12.5"></path>
  </svg>
</button>

<style>
  .next {
    position: fixed;
    left: 50%;
    bottom: max(14px, calc(env(safe-area-inset-bottom) + 6px));
    z-index: 20;
    display: grid;
    place-items: center;
    width: 44px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    /* Follows the screen on show: ivory on dark screens, bronze on light ones (html[data-surface]). */
    color: var(--on-screen);
    cursor: pointer;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      translate 0.4s ease,
      visibility 0s 0.4s;
  }
  /* Arrives with a small rise once the screen is complete; hidden it can't be focused or clicked. */
  .next.is-shown {
    opacity: 0.85;
    translate: -50% -6px;
    visibility: visible;
    transition:
      opacity 0.8s ease,
      translate 0.8s ease,
      visibility 0s;
  }
  /* Without motion the page scrolls normally, so there is nothing to cue. */
  :global(html:not(.motion)) .next {
    display: none;
  }

  /* Pointer: a mouse outline whose wheel rolls down and fades, again and again. */
  .next__mouse {
    position: relative;
    width: 22px;
    height: 34px;
    border: 1.5px solid currentColor;
    border-radius: 11px;
  }
  .next__wheel {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 2px;
    height: 6px;
    margin-left: -1px;
    border-radius: 1px;
    background: currentColor;
    animation: next-wheel 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes next-wheel {
    0% {
      opacity: 0;
      transform: translateY(-2px);
    }
    20% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
      transform: translateY(9px);
    }
  }

  /* Touch: two chevrons, the upper one first, as if the page is about to move on. */
  .next__chevrons {
    display: none;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .next__chevron {
    animation: next-chevron 1.8s ease-in-out infinite;
  }
  .next__chevron--2 {
    animation-delay: 0.22s;
  }
  @keyframes next-chevron {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(-2px);
    }
    40% {
      opacity: 1;
      transform: translateY(1px);
    }
  }
  @media (hover: none) and (pointer: coarse) {
    .next__mouse {
      display: none;
    }
    .next__chevrons {
      display: block;
    }
  }

  @media (hover: hover) {
    .next.is-shown:hover {
      opacity: 1;
    }
  }
  .next:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 12px;
  }
</style>
