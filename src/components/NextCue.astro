---
/**
 * "There is more": a round button with an arrow that draws itself downwards
 * (like the lines of the notes scene) and a copper pulse ring (like the
 * CTA), without words. navigation.ts shows it once a screen is complete and hides it on the
 * next step; clicking it is a step too. Ivory on dark scenes, bronze on light ones.
 */
---

<button class="next" type="button" data-next aria-label="Naar het volgende scherm">
  <span class="next__ring" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path class="next__stem" d="M12 5 V18" pathLength="20"></path>
      <path class="next__head" d="M7.5 13.5 L12 18 L16.5 13.5" pathLength="20"></path>
    </svg>
  </span>
</button>

<style>
  .next {
    position: fixed;
    left: 50%;
    bottom: max(18px, calc(env(safe-area-inset-bottom) + 8px));
    z-index: 20;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-sand);
    --pulse: 212 154 114;
    cursor: pointer;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      translate 0.4s ease,
      visibility 0s 0.4s;
  }
  /* Arrives with a small rise once the screen is complete; hidden it can't be focused or clicked. */
  .next.is-shown {
    opacity: 1;
    translate: -50% -6px;
    visibility: visible;
    transition:
      opacity 0.6s ease,
      translate 0.6s ease,
      visibility 0s;
  }
  .next.is-light {
    color: var(--color-bronze-900);
    --pulse: 156 85 48;
  }
  /* Without motion the page scrolls normally, so there is nothing to cue. */
  :global(html:not(.motion)) .next {
    display: none;
  }

  .next__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid currentColor;
    border-radius: 50%;
    animation: next-pulse 3.2s ease-out infinite;
  }
  .next__ring svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  /* The stem draws down, the head lands, both fade, and again: a slow beat. */
  .next__stem,
  .next__head {
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
    animation: next-draw 2.4s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }
  .next__head {
    animation-name: next-land;
  }
  @keyframes next-draw {
    0% {
      stroke-dashoffset: 20;
      opacity: 1;
    }
    40%,
    78% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes next-land {
    0%,
    30% {
      stroke-dashoffset: 20;
      opacity: 1;
    }
    55%,
    78% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes next-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(var(--pulse) / 0.4);
    }
    70%,
    100% {
      box-shadow: 0 0 0 14px rgb(var(--pulse) / 0);
    }
  }

  @media (hover: hover) {
    .next__ring {
      transition: background-color 0.4s;
    }
    .next:hover .next__ring {
      background-color: rgb(var(--pulse) / 0.14);
    }
  }
  .next:focus-visible {
    outline: none;
  }
  .next:focus-visible .next__ring {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 4px;
  }
</style>
