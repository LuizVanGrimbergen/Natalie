---
/**
 * "There is more": a small label over a thin line, on one centred axis. A light
 * segment glides along the line, down for a mouse (scroll) and up on touch
 * (the way the finger swipes). navigation.ts shows it once a screen is complete
 * and hides it on the next step; clicking it is a step too.
 */
---

<button class="next" type="button" data-next aria-label="Naar het volgende scherm">
  <span class="label next__label" aria-hidden="true"><span class="next__mouse">Scroll</span><span class="next__touch">Swipe</span></span>
  <span class="next__line" aria-hidden="true"><span class="next__glide"></span></span>
</button>

<style>
  .next {
    position: fixed;
    left: 50%;
    bottom: max(12px, calc(env(safe-area-inset-bottom) + 4px));
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 88px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    /* Follows the screen on show: ivory on dark screens, bronze on light ones (html[data-surface]). */
    color: var(--on-screen);
    cursor: pointer;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      translate 0.4s ease,
      visibility 0s 0.4s;
  }
  /* Arrives with a small rise once the screen is complete; hidden it can't be focused or clicked. */
  .next.is-shown {
    opacity: 1;
    translate: -50% -6px;
    visibility: visible;
    transition:
      opacity 0.8s ease,
      translate 0.8s ease,
      visibility 0s;
  }
  /* Without motion the page scrolls normally, so there is nothing to cue. */
  :global(html:not(.motion)) .next {
    display: none;
  }

  .next__label {
    font-size: 10px;
    letter-spacing: 0.4em;
    /* Letter-spacing trails after the last letter; this keeps the word on the axis. */
    margin-right: -0.4em;
    opacity: 0.72;
    transition: opacity 0.4s;
  }
  .next__touch {
    display: none;
  }

  /* The track: a faint hairline; the glide is a brighter segment moving along it. */
  .next__line {
    position: relative;
    width: 1px;
    height: 28px;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 28%, transparent);
  }
  .next__glide {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, currentColor 45%, currentColor 55%, transparent);
    animation: next-down 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes next-down {
    0% {
      transform: translateY(-100%);
    }
    70%,
    100% {
      transform: translateY(100%);
    }
  }
  @keyframes next-up {
    0% {
      transform: translateY(100%);
    }
    70%,
    100% {
      transform: translateY(-100%);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .next__mouse {
      display: none;
    }
    .next__touch {
      display: inline;
    }
    .next__glide {
      animation-name: next-up;
    }
  }

  @media (hover: hover) {
    .next:hover .next__label {
      opacity: 1;
    }
  }
  .next:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 4px;
  }
</style>
