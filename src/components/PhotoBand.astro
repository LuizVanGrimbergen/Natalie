---
/**
 * The photo band on top of a page (booking, research): a photo, the h1 (its accent
 * in the `accent` slot) and one line of facts. Like the story's photo scenes it looks
 * the same in both themes: dark wood edges, ivory words.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: ImageMetadata;
  /** The h1's plain words; the italic accent goes in the `accent` slot. */
  title: string;
  facts: string;
  /** object-position that keeps the subject in view on every width. */
  focus?: string;
}
const { photo, title, facts, focus = '50% 50%' } = Astro.props;
---

<div class="visual">
  <Picture
    class="visual__img"
    src={photo}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    alt=""
    aria-hidden="true"
    style={`object-position: ${focus}`}
    widths={[600, 900, 1200, 1600]}
    sizes="100vw"
    loading="eager"
  />
  <div class="visual__shade" aria-hidden="true"></div>
  <div class="visual__text">
    <h1 class="display visual__h">{title} <em><slot name="accent" /></em></h1>
    <p class="visual__facts">{facts}</p>
  </div>
</div>

<style>
  .visual {
    position: relative;
    height: min(48svh, 420px);
    overflow: hidden;
    background: var(--color-wood-950);
  }
  .visual :global(.visual__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* On arrival the photo settles, like the story's camera; then the words rise. */
    animation: visual-settle 2.4s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  @keyframes visual-settle {
    from {
      opacity: 0.4;
      transform: scale(1.08);
    }
  }
  @keyframes visual-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .visual__h {
    animation: visual-rise 1s 0.3s cubic-bezier(0.2, 0.6, 0.2, 1) backwards;
  }
  .visual__facts {
    animation: visual-rise 1s 0.5s cubic-bezier(0.2, 0.6, 0.2, 1) backwards;
  }
  /* Flat wood at the top (Safari's bar, the header) and at the bottom, where the text sits;
     in the dark theme that is the page itself, in the light one the ivory page starts below. */
  .visual__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--color-wood-950) 0%,
      color-mix(in srgb, var(--color-wood-950) 20%, transparent) 24%,
      color-mix(in srgb, var(--color-wood-950) 15%, transparent) 50%,
      color-mix(in srgb, var(--color-wood-950) 85%, transparent) 82%,
      var(--color-wood-950) 100%
    );
  }
  .visual__text {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-ivory);
  }
  .visual__h {
    font-size: 44px;
    line-height: 1;
  }
  .visual__h em {
    color: var(--color-copper-300);
  }
  .visual__facts {
    font-size: 14px;
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
  }

  @media (min-width: 700px) {
    .visual {
      height: min(56svh, 560px);
    }
    .visual__text {
      left: 50%;
      right: auto;
      width: min(560px, calc(100% - 48px));
      transform: translateX(-50%);
      bottom: 32px;
    }
    .visual__h {
      font-size: 64px;
    }
    .visual__facts {
      font-size: 15px;
    }
  }
</style>
