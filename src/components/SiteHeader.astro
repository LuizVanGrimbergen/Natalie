---
/**
 * The navbar: wordmark, the parts of the story, "Afspraak maken" and the
 * light/dark switch. From 900px the links sit in the bar; below that a hamburger
 * opens them full screen, centered. The menu is a <details>, so it opens without
 * JS; scripts/site-menu.ts closes it on a link or Escape and pauses the story's
 * steps while it is open. Its colors follow the screen on show (html[data-surface]).
 * On the story the links are in-page (#…); elsewhere they lead back to it.
 */
interface Props {
  /** Prefix for the story links: '' on the story itself, '/' on other pages. */
  base?: '' | '/';
}
const { base = '' } = Astro.props;

const links = [
  { href: `${base}#ruimte`, label: 'De ruimte' },
  { href: `${base}#luisteren`, label: 'Luisteren' },
  { href: `${base}#coaching`, label: 'Coaching' },
  { href: `${base}#natalie`, label: 'Over Natalie' },
];
---

<header class="header" data-header>
  <a class="header__wordmark" href={base ? '/' : '#start'}>Natalie</a>

  <div class="header__end">
    <nav class="header__nav" aria-label="Hoofdmenu">
      {links.map((link) => <a class="header__link" href={link.href}>{link.label}</a>)}
      <a class="header__cta" href="/booking">Afspraak maken</a>
    </nav>

    <!-- Light / dark: a circle, half filled. scripts/theme.ts sets its label and state. -->
    <button class="theme" type="button" data-theme-toggle aria-pressed="false" aria-label="Lichte weergave">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
        <path d="M12 4 A8 8 0 0 1 12 20 Z" fill="currentColor"></path>
      </svg>
    </button>

    <details class="menu" data-menu>
      <summary class="menu__button" aria-label="Menu">
        <span class="menu__bars" aria-hidden="true"></span>
      </summary>
      <div class="menu__panel">
        <nav class="menu__nav" aria-label="Menu">
          {links.map((link) => <a class="display menu__link" href={link.href}>{link.label}</a>)}
        </nav>
        <a class="menu__cta" href="/booking">Afspraak maken</a>
      </div>
    </details>
  </div>
</header>

<script>
  import { initSiteMenu } from '../scripts/site-menu';
  import { initThemeToggle } from '../scripts/theme';
  initSiteMenu();
  initThemeToggle();
</script>

<style>
  /* Fixed on top of every screen. Its backdrop fades from the page's own color at the
     very top (Safari's bar) to nothing, so the links stay readable over photos. */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 12px 20px;
    color: var(--on-screen);
    background: linear-gradient(180deg, var(--tint, var(--page)) 0%, transparent 100%);
    transition: color 0.4s;
  }
  .header__wordmark {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: inherit;
    text-decoration: none;
  }
  .header__end {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Desktop: the links in the bar. */
  .header__nav {
    display: none;
    align-items: center;
    gap: 32px;
    margin-right: 20px;
  }
  .header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 400;
    color: inherit;
    opacity: 0.78;
    text-decoration: none;
    transition: opacity 0.25s;
  }
  .header__link:hover {
    opacity: 1;
  }
  .header__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 400;
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .header__cta:hover {
    background: var(--on-screen);
    color: var(--tint, var(--page));
  }

  .theme {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  :global(html:not(.js)) .theme {
    display: none;
  }
  .theme svg {
    width: 20px;
    height: 20px;
    transition: transform 0.4s ease;
  }
  .theme[aria-pressed='true'] svg {
    transform: rotate(180deg);
  }

  /* Phone and tablet: the hamburger. */
  .menu__button {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    cursor: pointer;
    list-style: none;
  }
  .menu__button::-webkit-details-marker {
    display: none;
  }
  /* Two lines that turn into a cross. */
  .menu__bars,
  .menu__bars::before {
    display: block;
    width: 22px;
    height: 1px;
    background: currentColor;
    transition: transform 0.3s ease;
  }
  .menu__bars {
    position: relative;
    transform: translateY(-4px);
  }
  .menu__bars::before {
    content: '';
    position: absolute;
    top: 8px;
  }
  .menu[open] .menu__bars {
    transform: translateY(0) rotate(45deg);
  }
  .menu[open] .menu__bars::before {
    transform: translateY(-8px) rotate(-90deg);
  }
  /* Full screen in the page's own color; links and button in the middle. */
  .menu__panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 96px 24px max(32px, calc(env(safe-area-inset-bottom) + 20px));
    background: var(--tint, var(--page));
    text-align: center;
  }
  /* The links fill the middle of the screen; "Afspraak maken" sits at the bottom, within thumb's reach. */
  .menu__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .menu__link {
    display: block;
    padding: 6px 0;
    font-size: 40px;
    line-height: 1.15;
    color: inherit;
    text-decoration: none;
  }
  .menu__link:hover {
    opacity: 0.7;
  }
  .menu__cta {
    display: grid;
    place-items: center;
    width: min(320px, 100%);
    min-height: 52px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 16px;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .header {
      padding: 16px 40px;
    }
    .header__wordmark {
      font-size: 24px;
    }
    .header__nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }
</style>
