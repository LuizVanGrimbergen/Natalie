---
/** Wordmark plus one link; sits on top of the page (on the story it fades out after the hero). */
interface Props {
  href: string;
  /** Text color: ivory on the dark story page, bronze on light pages. */
  tone?: 'light' | 'dark';
}
const { href, tone = 'light' } = Astro.props;
---

<header class:list={['header', `header--${tone}`]} data-header>
  <a class="header__wordmark" href="/">Natalie</a>
  <a class="header__link" href={href}><slot /></a>
</header>

<style>
  .header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
  }
  .header--light {
    color: var(--color-sand);
  }
  .header--dark {
    color: var(--color-bronze-900);
  }
  .header__wordmark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 24px;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .header__link {
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 15px;
    font-weight: 400;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 10px) / 100% 1px no-repeat;
    opacity: 0.92;
    transition: opacity 0.3s;
  }
  .header__link:hover {
    opacity: 1;
  }
  @media (max-width: 820px) {
    .header {
      padding: 12px 20px;
    }
    .header__wordmark {
      font-size: 20px;
    }
    .header__link {
      font-size: 14px;
    }
  }
</style>
