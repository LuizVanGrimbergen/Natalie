---
// Visitors can send Natalie the songs they would like to hear, as Spotify links, through WhatsApp.
// TODO(Natalie): sample copy, still to be approved.
import { whatsapp } from '../../data/contact';

interface Props {
  /** Place in the page's rise-in order. */
  rise?: number;
}
const { rise = 0 } = Astro.props;

const message = 'Hoi Natalie, deze liedjes zou ik graag horen (Spotify):\n';
---

<p class="music" data-rise style={`--i: ${rise}`}>
  Is er muziek die je graag zou horen? Stuur je liedjes van Spotify mee, dan zet Natalie ze voor je klaar.
  <a class="music__link" href={whatsapp(message)} target="_blank" rel="noopener">Stuur je liedjes via WhatsApp&nbsp;→</a>
</p>

<style>
  .music {
    max-width: 440px;
    margin-top: 12px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--color-body-on-ivory);
  }
  .music__link {
    display: flex;
    width: fit-content;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 15px;
    color: var(--color-copper-700);
    text-decoration: underline;
    text-decoration-color: rgb(156 85 48 / 0.4);
    text-underline-offset: 5px;
  }
  .music__link:hover {
    text-decoration-color: var(--color-copper-700);
  }
  .music__link:focus-visible {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 4px;
  }
</style>
