---
// Google Calendar appointment schedule embed URLs (…/appointments/schedules/…?gv=true): one per session,
// as the two last differently long. Until Natalie has a second schedule, both fall back to PUBLIC_BOOKING_URL.
// scripts/booking.ts swaps the iframe when the visitor chooses another session.
const fallback = import.meta.env.PUBLIC_BOOKING_URL?.trim();
// hl=nl: Google shows the schedule in Dutch, whatever the visitor's browser language.
function dutch(raw?: string) {
  const value = raw?.trim() || fallback;
  if (!value) return undefined;
  const url = new URL(value);
  url.searchParams.set('hl', 'nl');
  return url.toString();
}
const soundroomUrl = dutch(import.meta.env.PUBLIC_BOOKING_URL_SOUNDROOM);
const coachingUrl = dutch(import.meta.env.PUBLIC_BOOKING_URL_COACHING);
const bookingUrl = soundroomUrl ?? coachingUrl;
// The same schedule as Google's own full page (without the embed flag): on a phone easier than a box in a page.
function fullPage(embed?: string) {
  if (!embed) return undefined;
  const url = new URL(embed);
  url.searchParams.delete('gv');
  return url.toString();
}
const fullUrl = fullPage(bookingUrl);
---

<section class="calendar" aria-label="Agenda">
  {
    bookingUrl ? (
      <iframe
        class="calendar__frame"
        src={bookingUrl}
        data-booking-calendar
        data-soundroom={soundroomUrl}
        data-coaching={coachingUrl}
        title="Afsprakenplanning van Natalie (Google Agenda)"
        loading="lazy"
      />
    ) : (
      <div class="calendar__empty">
        <p class="label calendar__label">Agenda</p>
        <p class="display calendar__title">
          Binnenkort kun je hier <em>een moment kiezen.</em>
        </p>
        <p class="calendar__text">De online afsprakenplanning wordt nog gekoppeld. Tot dan kun je Natalie rechtstreeks contacteren.</p>
      </div>
    )
  }
</section>
{
  fullUrl && (
    <a class="calendar__open" href={fullUrl} target="_blank" rel="noopener" data-booking-open>
      Open de agenda op volledig scherm&nbsp;↗
    </a>
  )
}

<style>
  .calendar {
    display: flex;
    min-height: 620px;
    overflow: hidden;
    background: rgb(255 253 248 / 0.7);
    border: 1px solid rgb(156 85 48 / 0.18);
    border-radius: 12px;
  }
  .calendar__frame {
    flex: 1;
    width: 100%;
    min-height: 720px;
    border: 0;
  }
  .calendar__empty {
    margin: auto;
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 440px;
  }
  .calendar__label,
  .calendar__title em {
    color: var(--color-copper-700);
  }
  .calendar__title {
    font-size: clamp(32px, 3vw, 44px);
    line-height: 1.05;
  }
  .calendar__text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body-on-ivory);
  }

  .calendar__open {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 12px;
    font-size: 15px;
    color: var(--color-copper-700);
    text-decoration: underline;
    text-decoration-color: rgb(156 85 48 / 0.4);
    text-underline-offset: 5px;
  }
  .calendar__open:hover {
    text-decoration-color: var(--color-copper-700);
  }
  .calendar__open:focus-visible {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 4px;
  }

  .calendar__open[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    /* The placeholder only takes the room it needs; the real calendar keeps its own height (the iframe's). */
    .calendar {
      min-height: 0;
    }
    /* Tall enough on a phone for the month and the times under it, so the box hardly scrolls by itself. */
    .calendar__frame {
      min-height: 1180px;
    }
    .calendar__empty {
      padding: 32px 24px;
    }
  }
</style>
