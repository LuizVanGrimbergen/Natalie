---
/**
 * The Cal.com booker of the chosen session (env vars in sessions.ts), drawn by
 * scripts/booking/cal.ts. Shown once a session is chosen; the button in People.astro
 * scrolls here. Without Cal.com links, a tidy placeholder; without JS, links to Cal.com.
 */
import SectionLabel from './SectionLabel.astro';
import { SESSIONS } from './sessions';

const links = Object.fromEntries(SESSIONS.filter((s) => s.calLink).map((s) => [s.id, s.calLink]));
const ready = Object.keys(links).length > 0;
---

<section class="calendar" id="moment" aria-labelledby="moment-title">
  <SectionLabel id="moment-title">Moment</SectionLabel>
  {
    ready ? (
      <div data-cal-embed data-links={JSON.stringify(links)}>
        <div class="calendar__box" data-cal-box>
          <p class="calendar__text">De agenda wordt geladen…</p>
        </div>
        <noscript>
          <div class="calendar__empty">
            {SESSIONS.filter((s) => s.calLink).map((s) => (
              <a class="calendar__link" href={`https://cal.com/${s.calLink}`}>
                Plan een sessie: {s.name} →
              </a>
            ))}
          </div>
        </noscript>
      </div>
    ) : (
      <div class="calendar__empty">
        <p class="calendar__text">De online agenda volgt binnenkort. Neem tot dan contact op met Natalie om af te spreken.</p>
      </div>
    )
  }
</section>

<script>
  import { initCalEmbed } from '../../scripts/booking/cal';
  const root = document.querySelector<HTMLElement>('[data-cal-embed]');
  if (root) initCalEmbed(root);
</script>

<style>
  .calendar {
    display: none;
    scroll-margin-top: 16px;
  }
  :global(body:has([name='session']:checked)) .calendar {
    display: block;
  }
  .calendar__box {
    min-height: 480px;
  }
  /* On wider screens the booker breaks out of the column, so it can show the month and the times side by side. */
  @media (min-width: 700px) {
    [data-cal-embed] {
      width: min(960px, 100vw - 48px);
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }
  .calendar__empty {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: 12px;
    background: var(--surface);
  }
  .calendar__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .calendar__link {
    color: var(--accent);
    font-size: 16px;
  }
</style>
