---
/**
 * Pick one of the two sessions: two plain rows, radio buttons underneath (no
 * form, nothing is sent). People and BookingCalendar follow the choice with CSS :has().
 */
import SectionLabel from './SectionLabel.astro';
import { SESSIONS, euro } from './sessions';
---

<fieldset class="pick">
  <SectionLabel as="legend">Kies je sessie</SectionLabel>
  <p class="pick__hint">Tik op Soundroom of Coaching om verder te gaan.</p>
  <div class="pick__options">
    {
      SESSIONS.map((s) => (
        <label class="option">
          <input class="option__input" type="radio" name="session" value={s.id} id={`session-${s.id}`} />
          <span class="option__radio" aria-hidden="true"></span>
          <span class="option__main">
            <span class="display option__name">{s.name}</span>
            <span class="option__text">{s.text}</span>
          </span>
          <span class="option__price">{euro(s.price)}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .pick {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .pick__options {
    display: grid;
    gap: 10px;
  }
  .option {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: var(--surface);
    cursor: pointer;
    transition: border-color 0.25s;
  }
  .option:hover {
    border-color: var(--outline);
  }
  .option:has(:checked) {
    border-color: var(--accent);
  }
  .option:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* The real radio stays in the page for keyboards and screen readers; the border shows the choice. */
  .option__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }
  /* Until a session is chosen, one line says what to do; the rows look tappable (a ring each, outlined). */
  .pick__hint {
    margin: -4px 0 14px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-soft);
  }
  :global(body:has([name='session']:checked)) .pick__hint {
    display: none;
  }
  :global(body:not(:has([name='session']:checked))) .option {
    border-color: var(--outline);
  }
  /* A plain radio ring, filled in copper once chosen: the choice itself. */
  .option__radio {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 4px;
    border: 1.5px solid var(--fg-muted);
    border-radius: 50%;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  .option:has(:checked) .option__radio {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 4px var(--surface), inset 0 0 0 11px var(--accent);
  }
  .option__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .option__name {
    font-size: 26px;
    line-height: 1.1;
  }
  .option__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .option__price {
    padding-top: 4px;
    font-size: 16px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
