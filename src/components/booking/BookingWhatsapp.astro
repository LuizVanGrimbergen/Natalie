---
// Book with Natalie through WhatsApp and send the songs you would like to hear (Spotify) in the same message.
// TODO(Natalie): sample copy, still to be approved.
import { whatsapp } from '../../data/contact';

interface Props {
  /** Place in the page's rise-in order. */
  rise?: number;
}
const { rise = 0 } = Astro.props;

const message = [
  'Hoi Natalie, ik maak graag een afspraak.',
  'Sessie (Soundroom of Coaching): ',
  'Wanneer: ',
  'Liedjes die ik graag zou horen (Spotify): ',
].join('\n');
---

<p class="music" data-rise style={`--i: ${rise}`}>
  Maak je afspraak via WhatsApp en stuur meteen de liedjes van Spotify mee die je graag zou horen. Natalie zet ze voor je klaar.
  <a class="music__link" href={whatsapp(message)} target="_blank" rel="noopener">Afspraak maken via WhatsApp&nbsp;→</a>
</p>

<style>
  .music {
    max-width: 440px;
    margin-top: 12px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--color-body-on-ivory);
  }
  .music__link {
    display: flex;
    width: fit-content;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 15px;
    color: var(--color-copper-700);
    text-decoration: underline;
    text-decoration-color: rgb(156 85 48 / 0.4);
    text-underline-offset: 5px;
  }
  .music__link:hover {
    text-decoration-color: var(--color-copper-700);
  }
  .music__link:focus-visible {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 4px;
  }
</style>
