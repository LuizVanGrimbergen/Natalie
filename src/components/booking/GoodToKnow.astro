---
// TODO(Natalie): sample copy from her notes on safety and measuring, awaiting her approval; contact comes from contact.ts.
import { contactHref, contactLabel } from '../../contact';
const notes = [
  'Maximaal drie mensen tegelijk, geen schermen.',
  'Er is altijd iemand in de buurt. Je kunt op elk moment stoppen, zonder uitleg.',
  'Dit is geen therapie en vervangt die ook niet. Heb je meer nodig, dan zoeken we samen waar je terecht kunt.',
  'We meten je hartslagvariabiliteit voor en na, om te leren wat de ruimte doet. Is er geen verschil, dan zeggen we dat ook.',
];
---

<section class="know" aria-label="Goed om te weten">
  <!-- Folded by default, so the page stays calm; one tap opens it. -->
  <details class="know__details">
    <summary class="know__summary">Goed om te weten<span class="know__mark" aria-hidden="true"></span></summary>
    <ul class="know__list">
      {notes.map((note) => <li>{note}</li>)}
    </ul>
  </details>
  <p class="know__contact">Vragen vooraf? {contactHref ? <a href={contactHref}>{contactLabel}</a> : contactLabel}</p>
</section>

<style>
  .know {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .know__details {
    border-radius: 12px;
    background: var(--surface);
  }
  .know__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    padding: 0 20px;
    font-size: 17px;
    font-weight: 400;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }
  .know__summary::-webkit-details-marker {
    display: none;
  }
  /* A plus that turns into a minus when open. */
  .know__mark {
    position: relative;
    width: 14px;
    height: 14px;
    color: var(--fg);
  }
  .know__mark::before,
  .know__mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: currentColor;
    transition: transform 0.3s ease;
  }
  .know__mark::after {
    transform: rotate(90deg);
  }
  .know__details[open] .know__mark::after {
    transform: rotate(0deg);
  }
  /* Readable: body size, near full color, a quiet hairline between the notes. */
  .know__list {
    margin: 0;
    padding: 0 20px 8px;
    list-style: none;
  }
  .know__list li {
    padding: 14px 0;
    border-top: 1px solid var(--hairline);
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg-soft);
  }
  .know__contact {
    font-size: 16px;
    color: var(--fg-soft);
  }
</style>
