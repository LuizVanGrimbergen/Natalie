---
/**
 * Booking in three steps, one open at a time: 1 the session, 2 the music (choose your own songs, or leave it to
 * Natalie), 3 the moment (the agenda).
 * Nothing is chosen at first. "Volgende" (active once a step has a choice) opens the next step; a finished step
 * folds into one line with what was chosen and a "Wijzig" button. The soundroom also asks how many people (1–3). scripts/booking.ts runs it. Without JavaScript every step is simply
 * open and the agenda is there at once.
 * Prices and sessions: Natalie's feedback of 19 October and the meeting of November (soundroom €35).
 */
import BookingCalendar from './BookingCalendar.astro';
import { formAsksSongs } from '../../data/booking';
import { whatsapp } from '../../data/contact';

const sessions = [
  {
    id: 'soundroom',
    name: 'Soundroom',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, zonder begeleiding.',
    price: '€35',
    duration: '50 minuten',
    songs: 13,
    // Up to 3 people in the soundroom, €25 for each one after the first.
    amount: 35,
    extra: { price: '+ €25', text: 'per bijkomende persoon · max. 3 personen', amount: 25, max: 3 },
  },
  {
    id: 'coaching',
    name: 'Coaching',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, met begeleiding van Natalie.',
    price: '€65',
    duration: '60 minuten',
    songs: 2,
    amount: 65,
  },
];

// There is always music in a session; the choice is who picks it. The song count follows the session
// (13 for the soundroom, 2 for coaching) and is filled in by scripts/booking.ts.
const music = [
  {
    id: 'own',
    name: 'Ik kies zelf liedjes',
    text: formAsksSongs
      ? 'Geef bij het boeken de liedjes door die je graag wil horen'
      : 'Stuur na het boeken de liedjes door die je graag wil horen',
    count: true,
    summary: 'Eigen liedjes',
  },
  {
    id: 'natalie',
    name: 'Ik kies liever niet',
    text: 'Natalie kiest de muziek voor je. Je hoeft niets voor te bereiden.',
    summary: 'Natalie kiest',
  },
];

const steps = ['Sessie', 'Muziek', 'Moment'];
---

<div class="booking" data-booking data-songs-via={formAsksSongs ? 'form' : 'whatsapp'}>
  <ol class="progress" aria-hidden="true" data-rise style="--i: 3">
    {
      steps.map((label, i) => (
        <li class="progress__item" data-progress={i + 1}>
          <span class="progress__dot">{i + 1}</span>
          <span class="progress__label">{label}</span>
        </li>
      ))
    }
  </ol>
  <p class="visually-hidden" aria-live="polite" data-announce></p>

  <section class="step" data-step="1" aria-labelledby="step-1" data-rise style="--i: 4">
    <div class="step__head">
      <span class="step__num" aria-hidden="true">1</span>
      <h2 id="step-1" class="step__title" tabindex="-1">Kies je sessie</h2>
      <span class="step__summary" data-summary></span>
      <button class="step__edit" type="button" data-edit="1" aria-label="Wijzig je sessie">Wijzig</button>
    </div>
    <div class="step__body">
      <div class="step__inner">
        <fieldset class="options">
          <legend class="visually-hidden">Kies je sessie</legend>
          {
            sessions.map((session) => (
              <label class="option">
                <input
                  class="option__input"
                  type="radio"
                  name="session"
                  value={session.id}
                  data-songs={session.songs}
                  data-name={session.name}
                  data-price={session.amount}
                  data-extra={session.extra?.amount}
                  data-max={session.extra?.max ?? 1}
                />
                <span class="option__mark" aria-hidden="true">
                  <svg viewBox="0 0 16 16" focusable="false"><path d="M3.5 8.5l3 3 6-7" /></svg>
                </span>
                <span class="option__main">
                  <span class="display option__name">{session.name}</span>
                  <span class="option__text">{session.text}</span>
                  <span class="option__meta">
                    <span class="option__price">{session.price}</span>
                    <span class="option__dot" aria-hidden="true">·</span>
                    <span>{session.duration}</span>
                  </span>
                  {
                    session.extra && (
                      <span class="option__extra">
                        <span class="option__price">{session.extra.price}</span> {session.extra.text}
                      </span>
                    )
                  }
                </span>
              </label>
            ))
          }
        </fieldset>
        {/* Soundroom only: how many people come (1 to 3). The total follows; the Google form can't take the
            number, so step 3 asks to mention it there. Shown by scripts/booking.ts. */}
        <div class="persons" data-persons hidden>
          <p class="persons__label" id="persons-label">Met hoeveel zijn jullie?</p>
          <div class="persons__row">
            <div class="stepper" role="group" aria-labelledby="persons-label">
              <button class="stepper__btn" type="button" data-persons-minus aria-label="Eén persoon minder">−</button>
              <output class="stepper__value" data-persons-value aria-live="polite">1</output>
              <button class="stepper__btn" type="button" data-persons-plus aria-label="Eén persoon meer">+</button>
            </div>
            <span class="persons__word" data-persons-word>persoon</span>
            <span class="persons__total">Totaal <strong data-total>€35</strong></span>
          </div>
        </div>
        <div class="step__actions">
          <button class="next" type="button" data-next disabled>Volgende<span aria-hidden="true">&nbsp;→</span></button>
        </div>
      </div>
    </div>
  </section>

  <section class="step" data-step="2" aria-labelledby="step-2" data-rise style="--i: 5">
    <div class="step__head">
      <span class="step__num" aria-hidden="true">2</span>
      <h2 id="step-2" class="step__title" tabindex="-1">Jouw muziek</h2>
      <span class="step__summary" data-summary></span>
      <button class="step__edit" type="button" data-edit="2" aria-label="Wijzig je keuze voor de muziek">Wijzig</button>
    </div>
    <div class="step__body">
      <div class="step__inner">
        <fieldset class="options options--two">
          <legend class="visually-hidden">Wie kiest de muziek?</legend>
          {
            music.map((choice) => (
              <label class="option option--compact">
                <input class="option__input" type="radio" name="music" value={choice.id} data-summary={choice.summary} />
                <span class="option__mark" aria-hidden="true">
                  <svg viewBox="0 0 16 16" focusable="false"><path d="M3.5 8.5l3 3 6-7" /></svg>
                </span>
                <span class="option__main">
                  <span class="display option__name">{choice.name}</span>
                  <span class="option__text">
                    {choice.text}
                    {choice.count && (
                      <>
                        {' '}
                        (<span data-song-max>tot 13 voor de soundroom, 2 bij coaching</span>).
                      </>
                    )}
                  </span>
                </span>
              </label>
            ))
          }
        </fieldset>
        <div class="step__actions">
          <button class="next" type="button" data-next disabled>Volgende<span aria-hidden="true">&nbsp;→</span></button>
        </div>
      </div>
    </div>
  </section>

  <section class="step" data-step="3" aria-labelledby="step-3" data-rise style="--i: 6">
    <div class="step__head">
      <span class="step__num" aria-hidden="true">3</span>
      <h2 id="step-3" class="step__title" tabindex="-1">Kies een moment</h2>
    </div>
    <div class="step__body">
      <div class="step__inner">
        {/* The songs and the number of people: in the Google booking form once it asks for them
            (data/booking.ts), until then on WhatsApp after booking, with a message ready (scripts/booking.ts). */}
        {
          formAsksSongs ? (
            <p class="step__note" data-songs-line>
              Vergeet niet je liedjes door te geven in het formulier: <span data-song-count>tot 13 voor de soundroom, 2 bij coaching</span>.
            </p>
          ) : (
            <>
              <p class="step__note" data-songs-line>
                Kies hieronder je moment. Stuur Natalie daarna je liedjes via WhatsApp: <span data-song-count>tot 13 voor de soundroom, 2 bij coaching</span>.
              </p>
              <p class="step__note" data-persons-note hidden>
                Kies hieronder je moment. Laat Natalie daarna via WhatsApp weten dat jullie met <span data-persons-count>2</span> komen.
              </p>
            </>
          )
        }
        <BookingCalendar />
        {
          formAsksSongs ? (
            <p class="step__note" data-persons-note hidden>
              Vermeld in het formulier dat jullie met <span data-persons-count>2</span> komen.
            </p>
          ) : (
            <div class="after" data-after hidden>
              <p class="label after__label">Na het boeken</p>
              <a class="after__wa" href={whatsapp()} target="_blank" rel="noopener" data-after-whatsapp>
                <span data-after-text>Stuur je liedjes via WhatsApp</span>
                <span aria-hidden="true">&nbsp;→</span>
              </a>
            </div>
          )
        }
        <p class="step__note step__note--quiet">Annuleren kan tot 24 uur op voorhand. Je betaalt met Bancontact.</p>
      </div>
    </div>
  </section>
</div>

<style>
  .booking {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ---- Progress: three dots on a line, the step you are on in copper ---- */
  .progress {
    display: none;
    margin: 8px 0 18px;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  :global([data-booking-ready]) .progress {
    display: flex;
  }
  .progress__item {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted-2);
  }
  /* The line to the next dot. */
  .progress__item:not(:last-child)::after {
    content: '';
    flex: 1;
    height: 1px;
    margin-right: 10px;
    background: rgb(156 85 48 / 0.22);
    transition: background 0.4s ease;
  }
  .progress__dot {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgb(156 85 48 / 0.35);
    border-radius: 50%;
    font-size: 12px;
    letter-spacing: 0;
    font-variant-numeric: lining-nums;
    transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }
  .progress__item.is-current {
    color: var(--color-bronze-900);
  }
  .progress__item.is-current .progress__dot {
    border-color: var(--color-copper-700);
    color: var(--color-copper-700);
    box-shadow: 0 0 0 4px rgb(156 85 48 / 0.12);
  }
  .progress__item.is-done .progress__dot {
    border-color: var(--color-copper-700);
    background: var(--color-copper-700);
    color: var(--color-ivory);
  }
  .progress__item.is-done::after {
    background: var(--color-copper-700);
  }

  /* ---- Steps ---- */
  .step {
    border-radius: 18px;
    background: rgb(255 253 248 / 0.55);
    border: 1px solid rgb(156 85 48 / 0.16);
    transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, opacity 0.4s ease;
  }
  .step.is-open {
    background: rgb(255 253 248 / 0.85);
    border-color: rgb(156 85 48 / 0.28);
    box-shadow: 0 30px 80px -40px rgb(200 143 128 / 0.55);
  }
  /* A step still to come: there, but quiet. */
  .step.is-locked {
    opacity: 0.55;
  }
  .step__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 14px;
    min-height: 44px;
    padding: 20px 24px;
  }
  .step__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-copper-700);
    border-radius: 50%;
    font-size: 14px;
    font-variant-numeric: lining-nums;
    color: var(--color-copper-700);
    transition: background 0.4s ease, color 0.4s ease;
  }
  .step.is-done .step__num {
    background: var(--color-copper-700);
    color: var(--color-ivory);
  }
  .step__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.15;
    color: var(--color-bronze-900);
  }
  .step__title:focus {
    outline: none;
  }
  .step__title:focus-visible {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 4px;
  }
  /* What was chosen, once a step is done: on the same line, pushed right, with "Wijzig" after it. */
  .step__summary {
    display: none;
    margin-left: auto;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 500;
    font-variant-numeric: lining-nums;
    color: var(--color-copper-700);
  }
  .step__edit {
    display: none;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--color-bronze-900);
    text-decoration: underline;
    text-decoration-color: rgb(156 85 48 / 0.45);
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .step.is-done:not(.is-open) .step__summary,
  .step.is-done:not(.is-open) .step__edit {
    display: inline-flex;
    align-items: center;
  }

  /* The body opens and closes by its own height (grid rows 0fr ↔ 1fr), no measuring. Without
     JavaScript ([data-booking-ready] is missing) every step stays open. */
  .step__body {
    display: grid;
    grid-template-rows: 1fr;
  }
  :global([data-booking-ready]) .step__body {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global([data-booking-ready]) .step.is-open .step__body {
    grid-template-rows: 1fr;
  }
  .step__inner {
    min-height: 0;
    overflow: hidden;
  }
  .step__inner > :global(*) {
    margin-left: 24px;
    margin-right: 24px;
  }
  .step__inner > :global(:last-child) {
    margin-bottom: 24px;
  }

  /* ---- Options: whole cards to tap ---- */
  .options {
    display: grid;
    gap: 12px;
    margin-top: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .options--two {
    grid-template-columns: 1fr 1fr;
  }
  .option {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 20px 20px 20px 18px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(156 85 48 / 0.22);
    cursor: pointer;
    transition: box-shadow 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  .option:active {
    transform: scale(0.99);
  }
  .option:has(.option__input:checked) {
    background: rgb(255 250 243 / 0.95);
    box-shadow:
      inset 0 0 0 2px var(--color-copper-700),
      0 18px 40px -24px rgb(156 85 48 / 0.45);
  }
  .option:has(.option__input:focus-visible) {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 3px;
  }
  /* The real radio stays in the page for keyboard and screen readers; the round mark shows it. */
  .option__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .option__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 4px;
    border: 1px solid rgb(156 85 48 / 0.6);
    border-radius: 50%;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .option__mark svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--color-ivory);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 16;
    stroke-dashoffset: 16;
    transition: stroke-dashoffset 0.3s ease 0.05s;
  }
  .option__input:checked ~ .option__mark {
    background: var(--color-copper-700);
    border-color: var(--color-copper-700);
  }
  .option__input:checked ~ .option__mark svg {
    stroke-dashoffset: 0;
  }
  .option__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .option__name {
    font-size: 28px;
    line-height: 1.1;
    color: var(--color-bronze-900);
  }
  .option--compact .option__name {
    font-size: 24px;
  }
  .option__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body-on-ivory);
  }
  /* Price and time in plain numerals (Cormorant's old-style figures read unclearly). */
  .option__meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 2px;
    font-size: 17px;
    font-variant-numeric: lining-nums;
    color: var(--color-bronze-900);
  }
  .option__price {
    font-weight: 500;
    color: var(--color-copper-700);
  }
  .option__dot {
    color: var(--color-muted-2);
  }
  .option__extra {
    font-size: 15px;
    line-height: 1.5;
    font-variant-numeric: lining-nums;
    color: var(--color-body-on-ivory);
  }

  /* ---- Persons (soundroom): − 1 + and the total ---- */
  .persons {
    margin-top: 18px;
    padding: 18px 20px;
    border-radius: 14px;
    background: rgb(156 85 48 / 0.06);
  }
  .persons[hidden] {
    display: none;
  }
  .persons__label {
    margin-bottom: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-bronze-900);
  }
  .persons__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    box-shadow: inset 0 0 0 1px rgb(156 85 48 / 0.35);
  }
  .stepper__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: none;
    font: inherit;
    font-size: 22px;
    line-height: 1;
    color: var(--color-copper-700);
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }
  .stepper__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .stepper__btn:focus-visible {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 2px;
  }
  .stepper__value {
    min-width: 28px;
    text-align: center;
    font-size: 20px;
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--color-bronze-900);
  }
  .persons__word {
    font-size: 16px;
    color: var(--color-body-on-ivory);
  }
  .persons__total {
    margin-left: auto;
    font-size: 16px;
    font-variant-numeric: lining-nums;
    color: var(--color-body-on-ivory);
  }
  .persons__total strong {
    font-weight: 500;
    color: var(--color-copper-700);
  }

  /* ---- Volgende: only with JavaScript, active once the step has a choice ---- */
  .step__actions {
    display: none;
    justify-content: flex-end;
    margin-top: 18px;
  }
  :global([data-booking-ready]) .step__actions {
    display: flex;
  }
  .next {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    border: 0;
    border-radius: 999px;
    background: var(--color-bronze-900);
    font: inherit;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--color-ivory);
    cursor: pointer;
    transition: background 0.3s ease, opacity 0.3s ease, transform 0.2s ease;
  }
  .next:active:not(:disabled) {
    transform: scale(0.98);
  }
  .next:disabled {
    opacity: 0.28;
    cursor: default;
  }
  .next:focus-visible {
    outline: 2px solid var(--color-copper-700);
    outline-offset: 3px;
  }

  /* Hover only where there is a real pointer: on a phone a tapped button kept its hover tint. */
  @media (hover: hover) {
    .option:hover {
      box-shadow: inset 0 0 0 1px rgb(156 85 48 / 0.55);
    }
    .stepper__btn:hover:not(:disabled) {
      background: rgb(156 85 48 / 0.1);
    }
    .next:hover:not(:disabled) {
      background: var(--color-copper-700);
    }
    .step__edit:hover {
      text-decoration-color: var(--color-copper-700);
    }
  }

  /* ---- Step 3 ---- */
  .step__note {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 21px;
    line-height: 1.4;
    color: var(--color-body-on-ivory);
  }
  .step__note[hidden] {
    display: none;
  }
  /* After booking (until the Google form asks for it): send the songs / the number of people on WhatsApp. */
  .after {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 22px;
    padding: 20px;
    border-radius: 14px;
    background: rgb(156 85 48 / 0.06);
  }
  .after[hidden] {
    display: none;
  }
  .after__label {
    color: var(--color-copper-700);
  }
  .after__wa {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    background: var(--color-bronze-900);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--color-ivory);
    text-decoration: none;
    transition: background 0.3s ease, transform 0.2s ease;
  }
  .after__wa:active {
    transform: scale(0.98);
  }
  @media (hover: hover) {
    .after__wa:hover {
      background: var(--color-copper-700);
    }
  }
  @media (max-width: 600px) {
    .after__wa {
      justify-content: center;
      width: 100%;
    }
  }
  .step__note--quiet {
    margin-top: 18px;
    font-size: 19px;
  }

  @media (max-width: 600px) {
    /* On a phone "Volgende" spans the card: one big target for the thumb. */
    .next {
      width: 100%;
      justify-content: center;
    }
    .persons {
      padding: 16px;
    }
    .options--two {
      grid-template-columns: 1fr;
    }
    .step__head {
      padding: 16px 16px;
      gap: 4px 12px;
    }
    .step__inner > :global(*) {
      margin-left: 12px;
      margin-right: 12px;
    }
    .step__inner > :global(:last-child) {
      margin-bottom: 14px;
    }
    .option {
