---
/**
 * With how many people (1 to MAX_PEOPLE), the total for the chosen session, and
 * the one button that goes on to the calendar. Radio buttons again; the total and
 * the button show with CSS :has(), so this works without JS. scripts/booking/cal.ts
 * passes the number on to Cal.com's booking form (question `personen`).
 */
import SectionLabel from './SectionLabel.astro';
import { FRIENDS_DISCOUNT, MAX_PEOPLE, SESSIONS, euro, pricePerPerson } from './sessions';

// Without a Cal.com link there is no calendar to pick a moment in yet, so the button says what to do instead.
const bookable = SESSIONS.some((s) => s.calLink);

const counts = Array.from({ length: MAX_PEOPLE }, (_, i) => i + 1);
const totals = SESSIONS.flatMap((s) =>
  counts.map((n) => ({
    key: `${s.id}-${n}`,
    rule: `body:has(#session-${s.id}:checked):has(#people-${n}:checked) [data-total="${s.id}-${n}"]`,
    amount: euro(pricePerPerson(s, n) * n),
    // With friends: the regular price struck through beside it.
    regular: n > 1 ? euro(s.price * n) : undefined,
  })),
);
// One rule per session × group size; generated so it follows sessions.ts.
const css = `${totals.map((t) => t.rule).join(',\n')} { display: inline; }`;
const discount = `${FRIENDS_DISCOUNT * 100}%`;
---

<fieldset class="people">
  <SectionLabel as="legend">Aantal personen</SectionLabel>
  <div class="segments">
    {
      counts.map((n) => (
        <label class="segment">
          <input class="segment__input" type="radio" name="people" value={n} id={`people-${n}`} checked={n === 1} />
          <span class="segment__n">{n}</span>
          <span class="sr-only">{n === 1 ? 'persoon' : 'personen'}</span>
          {n > 1 && (
            <span class="segment__deal">
              −{discount}
              <span class="sr-only"> per persoon</span>
            </span>
          )}
        </label>
      ))
    }
  </div>
  <p class="people__note">Kies eerst een sessie.</p>
</fieldset>

<script>
  // Until a session is chosen there is no price, so the number of people can't be picked yet (the CSS greys it out too).
  const people = document.querySelectorAll<HTMLInputElement>('input[name="people"]');
  const sync = () => {
    const chosen = !!document.querySelector('input[name="session"]:checked');
    for (const input of people) input.disabled = !chosen;
  };
  document.addEventListener('change', sync);
  addEventListener('pageshow', sync);
  sync();
</script>

<div class="sum">
  <p class="sum__row" aria-live="polite">
    <span class="sum__label">Totaal</span>
    <span class="sum__value">
      <span class="sum__none">Kies een sessie</span>
      {
        totals.map((t) => (
          <span class="sum__total" data-total={t.key}>
            {t.regular && (
              <s class="sum__regular">
                <span class="sr-only">Gewone prijs </span>
                {t.regular}
              </s>
            )}
            <span class="display sum__amount">{t.amount}</span>
          </span>
        ))
      }
    </span>
  </p>
  <a class="sum__go" href="#moment">{bookable ? 'Kies een moment' : 'Neem contact op om af te spreken'}</a>
</div>

<Fragment set:html={`<style>${css}</style>`} />

<style>
  .people {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .segments {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    background: var(--surface);
  }
  .segment {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 2px;
    min-height: 64px;
    padding: 10px 4px;
    border-radius: 9px;
    font-size: 17px;
    font-weight: 400;
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .segment:hover {
    color: var(--fg);
  }
  .segment:has(:checked) {
    background: var(--surface-strong);
    color: var(--fg);
  }
  .segment:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .segment__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }
  /* Under the number of 2 and 3: the friends discount. */
  .segment__deal {
    font-size: 12px;
    line-height: 1.4;
    color: var(--fg-muted);
  }
  .segment:has(:checked) .segment__deal {
    color: var(--fg-soft);
  }
  /* No session yet: the numbers wait, greyed out; the note says why. */
  :global(body:not(:has([name='session']:checked))) .segments {
    opacity: 0.45;
    pointer-events: none;
  }
  .people__note {
    margin-top: 10px;
    font-size: 14px;
    color: var(--fg-muted);
  }
  :global(body:has([name='session']:checked)) .people__note {
    display: none;
  }

  .sum {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }
  .sum__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .sum__label {
    font-size: 15px;
    color: var(--fg-muted);
  }
  .sum__value {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sum__none {
    font-size: 15px;
    color: var(--fg-muted);
  }
  :global(body:has([name='session']:checked)) .sum__none {
    display: none;
  }
  /* Only the total for the chosen session and group size is shown (rules generated above). */
  .sum__total {
    display: none;
  }
  .sum__regular {
    margin-right: 10px;
    font-size: 15px;
    color: var(--fg-faint);
    text-decoration-thickness: 1px;
  }
  .sum__amount {
    font-size: 32px;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  /* The one copper element: shows once a session is chosen. */
  .sum__go {
    display: none;
    place-items: center;
    min-height: 52px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .sum__go:hover {
    background: var(--accent-hover);
  }
  .sum__go:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  :global(body:has([name='session']:checked)) .sum__go {
    display: grid;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
