---
// Natalie's sessions and prices (her feedback of 19 October), with the price and duration set apart so they read at a glance.
const sessions = [
  {
    name: 'Soundroom',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, zonder begeleiding.',
    price: '€65',
    duration: '50 minuten',
    extra: '+ €15 per bijkomende persoon, max. 3 personen',
  },
  {
    name: 'Coaching',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, met begeleiding van Natalie.',
    price: '€75',
    duration: '65 minuten',
  },
];
---

<section class="details" aria-labelledby="booking-title">
  <h1 id="booking-title" class="display details__h">Afspraak <em>maken</em></h1>
  <p class="details__intro">Sommige ervaringen vragen geen woorden, maar ruimte.</p>
  <p class="label details__facts">Schoten, vanaf 18 jaar</p>

  <h2 class="label details__label">Kies je sessie</h2>
  <ul class="sessions">
    {
      sessions.map((session) => (
        <li class="session">
          <div class="session__head">
            <h3 class="display session__name">{session.name}</h3>
            <p class="session__price">
              <span class="display session__amount">{session.price}</span>
              <span class="label session__duration">{session.duration}</span>
            </p>
          </div>
          <p class="session__text">{session.text}</p>
          {session.extra && <p class="session__extra">{session.extra}</p>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 48px;
  }
  .details__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .details__h em {
    color: var(--color-copper-700);
  }
  .details__intro {
    max-width: 440px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.35;
    color: var(--color-body-on-ivory);
  }
  .details__facts {
    color: var(--color-copper-700);
  }
  .details__label {
    margin: 24px 0 0;
    font-weight: 400;
    color: var(--color-muted);
  }
  .sessions {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(156 85 48 / 0.25);
  }
  .session {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid rgb(156 85 48 / 0.25);
  }
  .session__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    max-width: 460px;
  }
  .session__name {
    font-size: 32px;
    line-height: 1.1;
  }
  .session__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }
  .session__amount {
    font-size: 34px;
    line-height: 1;
    color: var(--color-copper-700);
  }
  .session__duration {
    color: var(--color-muted);
  }
  .session__text,
  .session__extra {
    max-width: 460px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-body-on-ivory);
  }
  .session__extra {
    color: var(--color-copper-700);
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .details {
      position: static;
      gap: 20px;
    }
    .session__name {
      font-size: 28px;
    }
  }
</style>
