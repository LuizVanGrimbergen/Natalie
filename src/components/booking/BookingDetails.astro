---
// Natalie's sessions and prices (her feedback of 19 October): one quiet line per session with price, duration and who it is for
// (the soundroom is for everyone, coaching for 18 to 30).
import BookingWhatsapp from './BookingWhatsapp.astro';

const sessions = [
  {
    name: 'Soundroom',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, zonder begeleiding.',
    price: '€49',
    duration: '50 minuten',
    who: 'Voor iedereen',
    extra: { price: '+ €25', text: 'per bijkomende persoon · max.\u00a03\u00a0personen' },
  },
  {
    name: 'Coaching',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, met begeleiding van Natalie.',
    price: '€65',
    duration: '60 minuten',
    who: 'Van 18 tot 30 jaar',
  },
];
---

<section class="details" aria-labelledby="booking-title">
  <h1 id="booking-title" class="display details__h" data-rise style="--i: 0">Afspraak <em>maken</em></h1>
  <p class="details__intro" data-rise style="--i: 1">Sommige ervaringen vragen geen woorden, maar ruimte.</p>
  <p class="details__facts" data-rise style="--i: 2">Struikenlei, Schoten</p>

  <h2 class="label details__label" data-rise style="--i: 3">Kies je sessie</h2>
  <ul class="sessions">
    {
      sessions.map((session, i) => (
        <li class="session" data-rise style={`--i: ${4 + i}`}>
          <h3 class="display session__name">{session.name}</h3>
          <p class="session__text">{session.text}</p>
          <p class="session__meta">
            <span class="session__price">{session.price}</span>
            <span class="session__dot" aria-hidden="true">·</span>
            <span>{session.duration}</span>
          </p>
          <p class="session__who">{session.who}</p>
          {
            session.extra && (
              <p class="session__extra">
                <span class="session__price">{session.extra.price}</span> {session.extra.text}
              </p>
            )
          }
        </li>
      ))
    }
  </ul>

  <BookingWhatsapp rise={6} />
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 48px;
  }
  .details__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .details__h em {
    color: var(--color-copper-700);
  }
  .details__intro {
    max-width: 440px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.35;
    color: var(--color-body-on-ivory);
  }
  /* The place as one clear line, like the prices. */
  .details__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-copper-700);
  }
  .details__label {
    margin: 24px 0 0;
    font-weight: 400;
    color: var(--color-muted);
  }
  .sessions {
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
  }
  /* Each session a quiet block: name, what it is, then price and time. */
  .session {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 30px 0;
    position: relative;
  }
  /* The lines between the sessions draw themselves from the left, a moment after their session rises. */
  .sessions::before,
  .session::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgb(156 85 48 / 0.25);
    transform-origin: left;
    animation: draw-in 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .sessions::before {
    top: 0;
    animation-delay: 0.5s;
  }
  .session::after {
    bottom: 0;
    animation-delay: calc(0.45s + var(--i, 0) * 0.11s);
  }
  .session__name {
    font-size: 32px;
    line-height: 1.1;
  }
  .session__text {
    max-width: 460px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-body-on-ivory);
  }
  /* Price and time in plain numerals (Cormorant's old-style figures read unclearly). */
  .session__meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 4px;
    font-size: 18px;
    font-weight: 400;
    font-variant-numeric: lining-nums;
    color: var(--color-bronze-900);
  }
  .session__price {
    font-weight: 500;
    color: var(--color-copper-700);
  }
  .session__who {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-bronze-900);
  }
  .session__dot {
    color: var(--color-muted-2);
  }
  .session__extra {
    font-size: 16px;
    line-height: 1.5;
    font-variant-numeric: lining-nums;
    color: var(--color-body-on-ivory);
  }

  @media (max-width: 900px) {
    .details {
      position: static;
      gap: 20px;
    }
    .session__name {
      font-size: 28px;
    }

  }
</style>
