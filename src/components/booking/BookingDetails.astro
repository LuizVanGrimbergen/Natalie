---
// Natalie's sessions and prices (her feedback of 19 October); the calendar on the right stays a placeholder for now.
const sessions = [
  {
    name: 'Soundroom',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, zonder begeleiding, 65 euro voor 50 minuten.',
    extra: '15 Euro extra per bijkomende persoon, max 3 personen.',
  },
  {
    name: 'Coaching',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, met begeleiding van Natalie, 75 euro voor 65 minuten.',
  },
];
---

<section class="details" aria-labelledby="booking-title">
  <h1 id="booking-title" class="display details__h">Afspraak <em>maken</em></h1>
  <p class="details__intro">Sommige ervaringen vragen geen woorden, maar ruimte.</p>
  <p class="label details__facts">Schoten, vanaf 18 jaar</p>

  <h2 class="label details__label">Kies je sessie</h2>
  <ul class="sessions">
    {
      sessions.map((session) => (
        <li class="session">
          <h3 class="display session__name">{session.name}</h3>
          <p class="session__text">{session.text}</p>
          {session.extra && <p class="session__extra">{session.extra}</p>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 48px;
  }
  .details__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .details__h em {
    color: var(--color-copper-700);
  }
  .details__intro {
    max-width: 440px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.35;
    color: var(--color-body-on-ivory);
  }
  .details__facts {
    color: var(--color-copper-700);
  }
  .details__label {
    margin: 24px 0 0;
    font-weight: 400;
    color: var(--color-muted);
  }
  .sessions {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(156 85 48 / 0.25);
  }
  .session {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid rgb(156 85 48 / 0.25);
  }
  .session__name {
    font-size: 32px;
    line-height: 1.1;
  }
  .session__text,
  .session__extra {
    max-width: 460px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-body-on-ivory);
  }
  .session__extra {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .details {
      position: static;
      gap: 20px;
    }
    .session__name {
      font-size: 28px;
    }
  }
</style>
