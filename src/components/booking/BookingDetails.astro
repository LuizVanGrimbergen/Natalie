---
// Natalie's sessions and prices (her feedback of 19 October): one quiet line with price and duration per session.
import BookingMusic from './BookingMusic.astro';

const sessions = [
  {
    name: 'Soundroom',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, zonder begeleiding.',
    price: '€65',
    duration: '50 minuten',
    extra: '+ €15 per bijkomende persoon, max. 3 personen',
  },
  {
    name: 'Coaching',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, met begeleiding van Natalie.',
    price: '€75',
    duration: '65 minuten',
  },
];
---

<section class="details" aria-labelledby="booking-title">
  <h1 id="booking-title" class="display details__h">Afspraak <em>maken</em></h1>
  <p class="details__intro">Sommige ervaringen vragen geen woorden, maar ruimte.</p>
  <p class="label details__facts">Schoten, vanaf 18 jaar</p>

  <h2 class="label details__label">Kies je sessie</h2>
  <ul class="sessions">
    {
      sessions.map((session) => (
        <li class="session">
          <h3 class="display session__name">{session.name}</h3>
          <p class="session__text">{session.text}</p>
          <p class="session__meta">
            <span class="session__price">{session.price}</span>
            <span class="session__dot" aria-hidden="true">·</span>
            <span>{session.duration}</span>
          </p>
          {session.extra && <p class="session__extra">{session.extra}</p>}
        </li>
      ))
    }
  </ul>

  <BookingMusic />
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 48px;
  }
  .details__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .details__h em {
    color: var(--color-copper-700);
  }
  .details__intro {
    max-width: 440px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.35;
    color: var(--color-body-on-ivory);
  }
  .details__facts {
    color: var(--color-copper-700);
  }
  .details__label {
    margin: 24px 0 0;
    font-weight: 400;
    color: var(--color-muted);
  }
  .sessions {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(156 85 48 / 0.25);
  }
  /* Each session a quiet block: name, what it is, then price and time. */
  .session {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 30px 0;
    border-bottom: 1px solid rgb(156 85 48 / 0.25);
  }
  .session__name {
    font-size: 32px;
    line-height: 1.1;
  }
  .session__text {
    max-width: 460px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-body-on-ivory);
  }
  /* Price and time in plain numerals (Cormorant's old-style figures read unclearly). */
  .session__meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 4px;
    font-size: 18px;
    font-weight: 400;
    font-variant-numeric: lining-nums;
    color: var(--color-bronze-900);
  }
  .session__price {
    font-weight: 500;
    color: var(--color-copper-700);
  }
  .session__dot {
    color: var(--color-muted-2);
  }
  .session__extra {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .details {
      position: static;
      gap: 20px;
    }
    .session__name {
      font-size: 28px;
    }

  }
</style>
