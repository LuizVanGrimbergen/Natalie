---
// TODO(Natalie): intro, duration, price and contact are placeholders.
---

<section class="details" aria-labelledby="booking-title">
  <h1 id="booking-title" class="display details__h">Afspraak <em>maken</em></h1>
  <p class="details__intro">[KORTE INTRO OVER DE AFSPRAAK]</p>
  <dl class="facts">
    <div><dt class="label">Locatie</dt><dd>Schoten</dd></div>
    <div><dt class="label">Duur</dt><dd>[DUUR]</dd></div>
    <div><dt class="label">Prijs</dt><dd>[PRIJS]</dd></div>
    <div><dt class="label">Contact</dt><dd>[CONTACTGEGEVENS]</dd></div>
  </dl>
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: 48px;
  }
  .details__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .details__h em {
    color: var(--color-copper-700);
  }
  .details__intro {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-body-on-ivory);
  }
  .facts {
    margin: 8px 0 0;
    border-top: 1px solid rgb(156 85 48 / 0.25);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid rgb(156 85 48 / 0.25);
  }
  .facts dt {
    color: var(--color-copper-700);
  }
  .facts dd {
    margin: 0;
    font-size: 16px;
    color: var(--color-body-on-ivory);
  }

  @media (max-width: 900px) {
    .details {
      position: static;
      gap: 20px;
    }
    .details__intro {
      font-size: 16px;
    }
    .facts > div {
      grid-template-columns: 100px 1fr;
    }
  }
</style>
