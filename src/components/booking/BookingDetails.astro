---
// Natalie's sessions and prices (her feedback of 19 October), with the price and duration set apart so they read at a glance.
const sessions = [
  {
    name: 'Soundroom',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, zonder begeleiding.',
    facts: [
      { label: 'Prijs', value: '€65' },
      { label: 'Duur', value: '50 minuten' },
      { label: 'Per extra persoon', value: '+ €15', note: 'max. 3 personen' },
    ],
  },
  {
    name: 'Coaching',
    text: 'In verbinding gaan met klank & ruimte, op jouw tempo, met begeleiding van Natalie.',
    facts: [
      { label: 'Prijs', value: '€75' },
      { label: 'Duur', value: '65 minuten' },
    ],
  },
];
---

<section class="details" aria-labelledby="booking-title">
  <h1 id="booking-title" class="display details__h">Afspraak <em>maken</em></h1>
  <p class="details__intro">Sommige ervaringen vragen geen woorden, maar ruimte.</p>
  <p class="label details__facts">Schoten, vanaf 18 jaar</p>

  <h2 class="label details__label">Kies je sessie</h2>
  <ul class="sessions">
    {
      sessions.map((session) => (
        <li class="session">
          <h3 class="display session__name">{session.name}</h3>
          <p class="session__text">{session.text}</p>
          <dl class="facts">
            {
              session.facts.map((fact) => (
                <div class="fact">
                  <dt class="label fact__label">{fact.label}</dt>
                  <dd class="fact__value">
                    {fact.value}
                    {fact.note && <span class="fact__note">{fact.note}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 48px;
  }
  .details__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .details__h em {
    color: var(--color-copper-700);
  }
  .details__intro {
    max-width: 440px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.35;
    color: var(--color-body-on-ivory);
  }
  .details__facts {
    color: var(--color-copper-700);
  }
  .details__label {
    margin: 24px 0 0;
    font-weight: 400;
    color: var(--color-muted);
  }
  .sessions {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(156 85 48 / 0.25);
  }
  /* Each session a quiet block: name, what it is, then price and time in labelled columns. */
  .session {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 0;
    border-bottom: 1px solid rgb(156 85 48 / 0.25);
  }
  .session__name {
    font-size: 32px;
    line-height: 1.1;
  }
  .session__text {
    max-width: 460px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-body-on-ivory);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    margin: 8px 0 0;
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fact__label {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--color-muted);
  }
  .fact__value {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.1;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--color-bronze-900);
  }
  .fact__note {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .details {
      position: static;
      gap: 20px;
    }
    .session__name {
      font-size: 28px;
    }
    .fact__value {
      font-size: 20px;
    }
  }
</style>
