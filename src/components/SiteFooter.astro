---

<footer class="footer">
  <span class="display footer__name"><em>Natalie Vandervoort</em></span>
  <span>Schoten</span>
  <span>[CONTACTGEGEVENS]</span>
</footer>

<style>
  /* Continues the warm ivory at the bottom of the invitation scene. */
  .footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 48px;
    padding: 32px 6vw max(40px, calc(env(safe-area-inset-bottom) + 24px));
    background: var(--color-ivory-warm-2);
    box-shadow: inset 0 1px 0 rgb(156 85 48 / 0.25);
    font-size: 14px;
    color: var(--color-muted);
  }
  .footer__name {
    font-size: 20px;
    letter-spacing: 0;
    color: var(--color-bronze-900);
  }
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .footer {
      flex-direction: column;
      gap: 6px;
      padding-left: 24px;
      padding-right: 24px;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .footer {
      padding-left: 48px;
      padding-right: 48px;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .footer {
      padding-left: 10vw;
      padding-right: 10vw;
    }
  }
</style>
