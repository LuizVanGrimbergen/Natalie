---

<footer class="footer" data-footer>
  <span class="display footer__name"><em>Natalie Vandervoort</em></span>
  <span>Schoten</span>
  <span>[CONTACTGEGEVENS]</span>
</footer>

<style>
  /* The page color like the edges of the invitation scene, so Safari's bottom bar matches. */
  .footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 48px;
    padding: 32px 6vw max(40px, calc(env(safe-area-inset-bottom) + 24px));
    background: var(--page);
    box-shadow: inset 0 1px 0 var(--line);
    font-size: 14px;
    color: var(--label);
  }
  /* With motion: waits just below the screen until the last step slides it up over
     the bottom of the invitation (navigation.ts); the scene itself stays put. */
  :global(html.motion) .footer {
    position: fixed;
    left: 0;
    right: 0;
    top: 100%;
    /* Above every scene (their z-index is their order, 1–7). */
    z-index: 10;
  }
  .footer__name {
    font-size: 20px;
    letter-spacing: 0;
    color: var(--fg);
  }
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .footer {
      flex-direction: column;
      gap: 6px;
      padding-left: 24px;
      padding-right: 24px;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .footer {
      padding-left: 48px;
      padding-right: 48px;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .footer {
      padding-left: 10vw;
      padding-right: 10vw;
    }
  }
</style>
