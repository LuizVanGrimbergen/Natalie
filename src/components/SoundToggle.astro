---
/**
 * Optional music on the story page: a small round frosted button bottom right, under the progress rail
 * (that corner stays free on every scene, the invitation included). Off by default and never autoplaying:
 * scripts/sound.ts starts and stops it with a soft fade. A slash crosses the note while it is off.
 * With no soundtrack set (data/sound.ts) nothing renders.
 */
import { soundtrack } from '../data/sound';
---

{
  soundtrack && (
    <button class="sound" type="button" data-sound={soundtrack} aria-pressed="false" aria-label="Geluid aan" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 18V6l10-2v12" />
        <circle cx="6.5" cy="18" r="2.5" />
        <circle cx="16.5" cy="16" r="2.5" />
        <path class="sound__slash" d="M4 4l16 16" />
      </svg>
    </button>
  )
}

<style>
  .sound {
    position: fixed;
    right: max(14px, calc(env(safe-area-inset-right) + 8px));
    bottom: max(18px, calc(env(safe-area-inset-bottom) + 8px));
    z-index: 20;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(234 211 194 / 0.28);
    border-radius: 50%;
    background: rgb(18 16 13 / 0.55);
    color: var(--color-sand);
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .sound:hover {
    background: rgb(18 16 13 / 0.72);
  }
  .sound[aria-pressed='true'] {
    border-color: rgb(212 154 114 / 0.7);
  }
  .sound:focus-visible {
    outline: 2px solid var(--color-copper-300);
    outline-offset: 4px;
  }
  .sound svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sound[aria-pressed='true'] .sound__slash {
    display: none;
  }
</style>
