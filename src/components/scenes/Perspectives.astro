---
import NotesSvg from '../NotesSvg.astro';
---

<section class="scene perspectives" style="z-index: 3" data-tint="#F5F1E9" data-scene="perspectives" data-enter="dark" aria-labelledby="perspectives-title">
  <div class="stage">
    <div class="exit-dim exit-dim--light" aria-hidden="true"></div>
    <div class="warmth" aria-hidden="true" data-warmth></div>
    <div class="frame">
      <NotesSvg class="notes" />
      <div class="text">
        <p class="label text__label" data-reveal="1">Nieuwe perspectieven</p>
        <h2 id="perspectives-title" class="display text__h" data-reveal="1">Er is meer dan één manier <em>om te voelen.</em></h2>
        <p class="text__p" data-reveal="2">Een veilige plek waar je met jezelf kunt connecteren, experimenteren en luisteren.</p>
        <p class="text__p" data-reveal="3">
          Als je een bijkomende behoefte hebt, kun je die ook delen met Natalie, zodat je samen een begeleidend project kunt aangaan.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .perspectives,
  .stage {
    background: var(--color-ivory);
  }
  /* Copper-brown veil that lifts to ivory at the start of the scene. */
  .warmth {
    position: absolute;
    inset: 0;
    background: var(--color-copper-brown);
    opacity: 0;
    pointer-events: none;
  }
  .stage :global(.notes) {
    position: absolute;
    left: 4vw;
    top: 18%;
    width: 50vw;
    height: 64%;
  }
  .text {
    position: absolute;
    right: 6vw;
    top: 16%;
    width: min(520px, 38vw);
    display: flex;
    flex-direction: column;
    gap: 28px;
    color: var(--color-bronze-900);
  }
  .text__label {
    color: var(--color-copper-brown);
  }
  .text__h {
    font-size: clamp(44px, 4.6vw, 80px);
    line-height: 1;
  }
  .text__h em {
    color: var(--color-copper-700);
  }
  .text__p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-body-on-ivory);
  }

  /* Phone: the drawing is wide, so it is scaled to its right part (loop, notes, beam)
     and the start of the copper line runs in from beyond the left edge. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .stage :global(.notes) {
      --w: 147vw;
      left: -42vw;
      width: var(--w);
      height: calc(var(--w) * 7 / 8);
      top: calc(34% - var(--w) * 7 / 16);
    }
    .stage :global(.notes [data-draw]) {
      stroke-width: 2.6;
    }
    .text {
      left: 24px;
      right: 24px;
      top: auto;
      bottom: 6%;
      width: auto;
      gap: 20px;
    }
    .text__h {
      font-size: 40px;
    }
    .text__p {
      font-size: 16px;
      line-height: 1.65;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .text {
      left: 48px;
      right: 48px;
    }
    .text__h {
      font-size: 52px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .stage :global(.notes) {
      top: calc(25% - var(--w) * 7 / 16);
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 30px;
    }
    .text__p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      top: 10%;
      gap: 12px;
    }
    .text__h {
      font-size: clamp(24px, 8vh, 40px);
    }
    .text__p {
      font-size: 13px;
      line-height: 1.5;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .stage :global(.notes) {
      left: 6vw;
      width: 88vw;
      top: 9%;
      height: 38%;
    }
    .text {
      left: 12vw;
      right: 12vw;
      top: 52%;
      bottom: auto;
      width: auto;
      gap: 22px;
    }
    .text__h {
      font-size: clamp(44px, 7vw, 68px);
    }
    .text__p {
      font-size: clamp(17px, 2.3vw, 21px);
      line-height: 1.65;
    }
  }
</style>
