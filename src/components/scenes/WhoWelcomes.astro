---
import { Picture } from 'astro:assets';
import QuietLink from '../QuietLink.astro';
// TODO(Natalie): her portrait is still to be taken; until then the dome in the forest stands in.
import portrait from '../../assets/forest.avif';
---

<section class="scene welcomes" style="z-index: 4" data-tint="#F5F1E9" data-scene="welcomes" data-enter="light" aria-labelledby="welcomes-title">
  <div class="stage">
    <div class="window-light" aria-hidden="true"></div>
    <div class="frame">
      <div class="grid">
        <div class="text">
          <p class="label text__label" data-reveal="1">Een luisterend oor</p>
          <h2 id="welcomes-title" class="display text__h" data-reveal="2">
            Ik ben er niet om je de weg te wijzen. <em>Wel om de deur open te houden.</em>
          </h2>
          <!-- Natalie's text "Deur open" (28 October), verbatim, in place of the earlier sample text. -->
          <div class="text__body" data-reveal="3">
            <p>
              Ik geloof diep dat jonge mensen behoefte hebben aan veilige plekken waar ze even kunnen vertragen, tot rust kunnen
              komen en helemaal zichzelf mogen zijn. Plekken waar ze opnieuw verbinding kunnen voelen met zichzelf, met anderen en
              met wat er in hen leeft. Muziek kan daarin iets bijzonders betekenen: ze kan troosten, ruimte geven en helpen om
              gevoelens te uiten wanneer woorden tekortschieten.
            </p>
            <p>
              Vanuit die overtuiging heb ik deze ruimte met veel liefde gecreëerd. Alles is bewust vormgegeven, van de geometrie en
              de sfeer tot het pure vakmanschap, zodat er een omgeving ontstaat die rust uitstraalt en uitnodigt tot verbinding.
            </p>
            <p>
              Het mooiste compliment dat ik kan krijgen, is wanneer jonge mensen hier niet alleen tot rust komen, maar ook voelen dat
              ze welkom zijn, zichzelf mogen zijn en opnieuw echt thuiskomen bij zichzelf.
            </p>
          </div>
          <div class="text__end" data-reveal="4">
            <p class="text__sign">
              <em class="display">Natalie Van der Voort</em>
              <span class="label text__org">The Mereon Legacy</span>
            </p>
            <QuietLink href="/about">Lees mijn verhaal</QuietLink>
          </div>
        </div>
        <figure class="portrait" data-unveil>
          <div class="portrait__frame">
            <Picture
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              class="portrait__img"
              src={portrait}
              alt="Het houten ruimteschip tussen de bomen in het bos"
              widths={[480, 720, 960]}
              sizes="(max-width: 820px) 80vw, 40vw"
            />
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    background: var(--color-ivory);
    color: var(--color-bronze-900);
  }
  /* Soft window light falling diagonally across the wall. */
  .window-light {
    position: absolute;
    right: -14%;
    top: -18%;
    width: 80vw;
    height: 110%;
    background: radial-gradient(ellipse 50% 32% at 50% 50%, rgb(255 252 246 / 0.9), rgb(255 252 246 / 0.35) 45%, rgb(255 252 246 / 0) 70%);
    transform: rotate(-28deg);
    pointer-events: none;
  }
  /* Natalie's text is three paragraphs: the text column takes more room, the photo a little less. */
  .grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 5vw;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.4vh, 22px);
  }
  .text__label {
    color: var(--color-copper-700);
  }
  .text__h {
    font-size: clamp(30px, min(3.4vw, 5.6vh), 60px);
    line-height: 1.06;
  }
  .text__h em {
    color: var(--color-copper-700);
  }
  .text__body {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    max-width: 580px;
    font-size: clamp(14px, min(1.15vw, 2vh), 17px);
    line-height: 1.62;
    color: var(--color-body-on-ivory);
  }
  .text__sign {
    font-size: clamp(22px, 3.2vh, 30px);
  }
  .text__sign em {
    display: block;
    letter-spacing: 0;
  }
  .text__org {
    display: block;
    margin-top: 4px;
    color: var(--color-muted);
  }
  /* Her signature beside the way to her whole story (/about). */
  .text__end {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 28px;
    max-width: 580px;
  }

  .portrait {
    position: relative;
    height: min(70%, 640px);
    max-width: 100%;
    aspect-ratio: 4 / 5;
    justify-self: end;
    will-change: clip-path, transform;
  }
  .portrait__frame {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(165deg, #e6ded2, #cfc3b4);
  }
  .portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% 50%;
  }

  /* Phones and narrow portrait screens: the text alone, top to bottom (the photo stands in for a portrait
     that is still to come; the text matters more here). */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .window-light {
      width: 120vw;
      right: -40%;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      padding: 76px 24px 16px;
    }
    .portrait {
      display: none;
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 27px;
    }
    .text__body {
      font-size: 14.5px;
      line-height: 1.55;
    }
    .text__sign {
      font-size: 22px;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .grid {
      padding: 96px 64px 48px;
    }
    .text__h {
      font-size: 42px;
    }
    .text__body {
      font-size: 18px;
      max-width: none;
    }
  }
  /* Short phones (iPhone SE): tighter still. */
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .grid {
      align-content: center;
      padding: 66px 16px 0;
    }
    .text {
      gap: 8px;
    }
    .text__label {
      display: none;
    }
    .text__h {
      font-size: 19px;
    }
    .text__body {
      font-size: 12px;
      line-height: 1.38;
      gap: 0.45em;
    }
    /* Signature and link on one row. */
    .text__end {
      flex-wrap: nowrap;
      align-items: center;
      gap: 12px;
      padding-right: 6px;
    }
    .text__sign {
      font-size: 16px;
      white-space: nowrap;
    }
    .text__org {
      font-size: 9px;
      letter-spacing: 0.22em;
    }
    .text__end :global(.quiet) {
      gap: 8px;
      font-size: 12.5px;
      white-space: nowrap;
    }
  }
  /* Phone landscape: no photo, the text in two columns. */
  @media (min-width: 560px) and (max-height: 520px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      padding: 0 var(--gutter);
    }
    .portrait {
      display: none;
    }
    .text {
      gap: 8px;
    }
    .text__label {
      display: none;
    }
    .text__h {
      font-size: clamp(18px, 5.4vh, 28px);
    }
    .text__body {
      display: block;
      columns: 2;
      column-gap: 32px;
      max-width: none;
      font-size: clamp(11px, 3vh, 13px);
      line-height: 1.45;
    }
    .text__body p + p {
      margin-top: 0.5em;
    }
    .text__body p {
      break-inside: avoid-column;
    }
    .text__end {
      max-width: none;
    }
    .text__sign {
      font-size: 18px;
    }
  }
  /* Tablet portrait: a small photo on top, the text full width under it. */
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      align-content: center;
      gap: 26px;
      padding: 9vh var(--gutter) 5vh;
    }
    .portrait {
      display: block;
      height: min(24vh, 320px);
      max-height: none;
      justify-self: start;
      order: -1;
    }
    .text__h {
      font-size: clamp(36px, 5.2vw, 52px);
    }
    .text__body {
      font-size: clamp(17px, 2.1vw, 20px);
      max-width: none;
    }
    .text__end {
      max-width: none;
    }
  }
</style>
