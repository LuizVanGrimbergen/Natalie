---
// TODO(Natalie): personal text below is sample copy awaiting her approval. The portrait is the booking photo
// for now (Natalie in the opening of the soundroom), until there is a portrait of its own.
import { Picture } from 'astro:assets';
import photo from '../../assets/booking.avif';
---

<section id="natalie" class="scene welcomes" data-tint="#120A05" data-tint-light="#F5F1E9" data-scene="welcomes" aria-labelledby="welcomes-title">
  <div class="stage">
    <div class="exit-dim exit-dim--dark" aria-hidden="true"></div>
    <div class="window-light" aria-hidden="true"></div>
    <div class="frame">
      <div class="grid">
        <div class="text">
          <p class="label text__label" data-reveal="1">Wie je ontvangt</p>
          <h2 id="welcomes-title" class="display text__h" data-reveal="2">
            Een plek om <em>even stil te staan.</em>
          </h2>
          <p class="text__body" data-reveal="3">
            Ik geloof dat niemand los staat van de relaties, ruimtes en ritmes waarin we leven. Toch zijn we vaak zo druk met alles
            om ons heen, dat we vergeten naar onszelf te luisteren. Daarom maakte ik deze plek: een ruimte waar je niets moet. Ik
            ontvang je graag, met een open blik en aandacht voor jouw verhaal.
          </p>
          <p class="display text__sign" data-reveal="4"><em>Natalie</em></p>
        </div>
        <figure class="portrait" data-unveil>
          <div class="portrait__frame">
            <Picture
              class="portrait__img"
              src={photo}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              alt="Natalie Vandervoort in de opening van de soundroom"
              widths={[400, 600, 900]}
              sizes="(max-width: 820px) 70vw, 36vw"
            />
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    background: var(--page);
    color: var(--fg);
  }
  /* Soft warm light falling diagonally across the wall, well clear of the screen edges. */
  .window-light {
    position: absolute;
    right: -14%;
    top: -18%;
    width: 80vw;
    height: 110%;
    background: radial-gradient(ellipse 50% 32% at 50% 50%, rgb(156 85 48 / 0.2), rgb(156 85 48 / 0.08) 45%, rgb(156 85 48 / 0) 70%);
    transform: rotate(-28deg);
    pointer-events: none;
  }
  .grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 5vw;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .text__label {
    color: var(--label);
  }
  .text__h {
    font-size: clamp(34px, 4.2vw, 72px);
    line-height: 1.04;
  }
  .text__h em {
    color: var(--accent);
  }
  .text__body {
    max-width: 460px;
    font-size: 18px;
    line-height: 1.75;
  }
  .text__sign {
    font-size: 32px;
    letter-spacing: 0;
  }

  .portrait {
    position: relative;
    height: min(76%, 720px);
    aspect-ratio: 4 / 5;
    justify-self: end;
    will-change: clip-path, transform;
  }
  .portrait__frame {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(165deg, var(--portrait-from), var(--portrait-to));
  }
  .portrait :global(.portrait__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps Natalie's face in the frame. */
    object-position: 38% 30%;
  }

  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .window-light {
      width: 120vw;
      right: -40%;
    }
    /* The portrait takes all the height the text leaves free. */
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 24px;
      padding: 72px 24px 32px;
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 30px;
    }
    .text__body {
      font-size: 15px;
      line-height: 1.6;
    }
    .text__sign {
      font-size: 26px;
    }
    .portrait {
      height: 100%;
      max-height: 460px;
      max-width: 100%;
      align-self: end;
      justify-self: center;
      order: -1;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .grid {
      padding: 96px 48px 48px;
    }
    .text__h {
      font-size: 44px;
    }
    .text__body {
      font-size: 18px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .grid {
      padding: 56px 20px 20px;
      gap: 14px;
    }
    .text__h {
      font-size: 24px;
    }
    .text__body {
      font-size: 14px;
      line-height: 1.5;
    }
    .text__sign {
      font-size: 22px;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      gap: 10px;
    }
    .text__h {
      font-size: clamp(20px, 7vh, 36px);
    }
    .text__body {
      font-size: 13px;
      line-height: 1.5;
    }
    .text__sign {
      font-size: 20px;
    }
    .portrait {
      height: 78%;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      align-content: center;
      gap: 28px;
      padding: 10vh var(--gutter) 6vh;
    }
    .portrait {
      height: min(30vh, 380px);
      max-height: none;
      justify-self: start;
      order: -1;
    }
    .text__h {
      font-size: clamp(40px, 5.8vw, 58px);
    }
    .text__body {
      font-size: clamp(18px, 2.3vw, 21px);
      max-width: none;
    }
  }
</style>
