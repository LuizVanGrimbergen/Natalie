---
import { Picture } from 'astro:assets';
import interior from '../../assets/interior.avif';
import EdgeFade from '../EdgeFade.astro';
---

<section class="scene listening" style="z-index: 2" data-tint="#120A05" data-scene="listening" data-enter="dark" aria-labelledby="listening-title">
  <div class="stage">
    <Picture
      formats={['avif', 'webp']}
      quality={38}
      fallbackFormat="jpg"
      class="room__img"
      src={interior}
      alt=""
      aria-hidden="true"
      widths={[800, 1200, 1600, 2400]}
      sizes="100vw"
      data-room-img
    />
    <div class="room__dim" aria-hidden="true" data-room-dim></div>
    <div class="room__scrim" aria-hidden="true"></div>
    <EdgeFade color="#120A05" />

    <div class="frame">
      <div class="copy">
        <!-- Two voices only, as in scenes 04 and 05: a label over the title (with one italic accent), the body in
             Figtree; the closing line in Cormorant italic. Title top left, the rest along the bottom. -->
        <div class="copy__top">
          <p class="label copy__b" data-reveal="1">Een ervaring om te voelen</p>
          <h2 id="listening-title" class="display copy__h" data-reveal="1">Soms hoef je alleen maar <em>te luisteren.</em></h2>
        </div>
        <p class="copy__a" data-reveal="2">
          Een geometrische ruimte met unieke luidsprekers, en muziek die je van alle kanten omringt.
        </p>
        <p class="display copy__c" data-reveal="3">
          <em>Geen afleiding, geen verwachtingen. Alleen de klanken en wat ze in je oproepen.</em>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    background: var(--color-wood-950);
  }
  .room__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 54%;
    will-change: transform;
  }
  .room__dim,
  .room__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .room__dim {
    background: #0a0604;
    opacity: 0;
  }
  .room__scrim {
    background:
      linear-gradient(90deg, rgb(10 7 5 / 0.78) 0%, rgb(10 7 5 / 0.25) 38%, rgb(10 7 5 / 0.25) 62%, rgb(10 7 5 / 0.78) 100%),
      linear-gradient(180deg, rgb(10 7 5 / 0.55) 0%, rgb(10 7 5 / 0) 30%, rgb(10 7 5 / 0) 60%, rgb(10 7 5 / 0.7) 100%);
  }

  .copy {
    position: absolute;
    inset: 0;
    z-index: 3;
    color: var(--color-sand);
  }
  .copy > * {
    position: absolute;
    text-shadow:
      0 2px 28px rgb(10 6 3 / 0.9),
      0 0 2px rgb(10 6 3 / 0.6);
  }
  .copy__top {
    left: var(--gutter);
    top: 12%;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 34vw;
  }
  .copy__b {
    color: var(--color-copper-300);
  }
  .copy__h {
    font-size: clamp(44px, 5.2vw, 92px);
    line-height: 0.98;
  }
  .copy__h em {
    color: var(--color-copper-300);
  }
  /* The bottom line: the body left, the closing line right, on one baseline. */
  .copy__a {
    left: var(--gutter);
    bottom: 10%;
    max-width: 340px;
    font-size: 18px;
    line-height: 1.7;
    font-weight: 400;
  }
  .copy__c {
    right: var(--gutter);
    bottom: 10%;
    max-width: 480px;
    text-align: right;
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1.25;
  }

  /* Stacked (phone + tablet portrait): label and title on top, the rest grouped at the bottom. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px), (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .room__scrim {
      background: linear-gradient(180deg, rgb(10 7 5 / 0.75) 0%, rgb(10 7 5 / 0.35) 30%, rgb(10 7 5 / 0.55) 55%, rgb(10 7 5 / 0.9) 100%);
    }
    .copy {
      display: flex;
      flex-direction: column;
      padding: 76px 24px max(18vh, 120px);
    }
    .copy > * {
      position: static;
      max-width: none;
      text-align: left;
    }
    .copy__top {
      gap: 14px;
    }
    .copy__h {
      font-size: 40px;
      line-height: 1.02;
    }
    .copy__a {
      margin-top: auto;
      font-size: 16px;
      line-height: 1.6;
    }
    .copy__c {
      margin-top: 18px;
      font-size: 24px;
      line-height: 1.3;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .copy {
      padding: 96px 48px max(16vh, 120px);
    }
    .copy__h {
      font-size: 60px;
    }
    .copy__a {
      font-size: 19px;
    }
    .copy__c {
      font-size: 30px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .copy {
      padding: 64px 20px max(12vh, 64px);
    }
    .copy__top {
      gap: 10px;
    }
    .copy__h {
      font-size: 32px;
    }
    .copy__a {
      font-size: 14px;
      line-height: 1.5;
    }
    .copy__c {
      font-size: 19px;
    }
  }
  /* Phone landscape: the desktop layout, compact. */
  @media (min-width: 560px) and (max-height: 520px) {
    .copy__top {
      top: 10%;
      gap: 10px;
      max-width: 44vw;
    }
    .copy__h {
      font-size: clamp(26px, 9vh, 48px);
    }
    .copy__a {
      bottom: 8%;
      max-width: 34vw;
      font-size: 13px;
      line-height: 1.5;
    }
    .copy__c {
      bottom: 8%;
      max-width: 40vw;
      font-size: 17px;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .copy {
      padding: 12vh var(--gutter) max(16vh, 120px);
    }
    .copy__top {
      gap: 20px;
    }
    .copy__h {
      font-size: clamp(52px, 7.5vw, 76px);
    }
    .copy__a {
      font-size: clamp(18px, 2.4vw, 22px);
      line-height: 1.6;
    }
    .copy__c {
      margin-top: 22px;
      font-size: clamp(28px, 3.8vw, 38px);
    }
  }
</style>
