---
import { Picture } from 'astro:assets';
import interior from '../../assets/interior.avif';
---

<section class="scene listening" style="z-index: 2" data-tint="#140B05" data-scene="listening" data-enter="dark" aria-labelledby="listening-title">
  <div class="stage">
    <div class="exit-dim exit-dim--dark" aria-hidden="true"></div>
    <Picture
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      class="room__img"
      src={interior}
      alt=""
      aria-hidden="true"
      widths={[800, 1200, 1600, 2400]}
      sizes="100vw"
      data-room-img
    />
    <div class="room__dim" aria-hidden="true" data-room-dim></div>
    <div class="room__scrim" aria-hidden="true"></div>

    <div class="frame">
      <div class="copy">
        <h2 id="listening-title" class="display copy__h" data-reveal="1">Soms hoef je alleen maar te luisteren.</h2>
        <p class="copy__a" data-reveal="2">
          In een bijzondere geometrische ruimte, met speciaal op maat gemaakte luidsprekers, word je van alle kanten omringd door
          muziek.
        </p>
        <p class="copy__b" data-reveal="3">Een geluidservaring die je nauwelijks kunt bevatten, maar des te meer kunt voelen.</p>
        <p class="display copy__c" data-reveal="4">
          <em>Geen afleiding, geen verwachtingen. Alleen de muziek en wat ze bij je oproept.</em>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .listening {
    background: #17130f;
  }
  .stage {
    background: var(--color-wood-950);
  }
  .room__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 52% 74%;
    will-change: transform;
  }
  .room__dim,
  .room__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .room__dim {
    background: #0a0604;
    opacity: 0;
  }
  .room__scrim {
    background:
      linear-gradient(90deg, rgb(10 7 5 / 0.78) 0%, rgb(10 7 5 / 0.25) 38%, rgb(10 7 5 / 0.25) 62%, rgb(10 7 5 / 0.78) 100%),
      linear-gradient(180deg, rgb(10 7 5 / 0.55) 0%, rgb(10 7 5 / 0) 30%, rgb(10 7 5 / 0) 60%, rgb(10 7 5 / 0.7) 100%);
  }

  .copy {
    position: absolute;
    inset: 0;
    z-index: 3;
    color: var(--color-ivory);
  }
  .copy > * {
    position: absolute;
    text-shadow:
      0 2px 28px rgb(10 6 3 / 0.9),
      0 0 2px rgb(10 6 3 / 0.6);
  }
  .copy__h {
    left: 6vw;
    top: 12%;
    max-width: 30vw;
    font-size: clamp(44px, 5.2vw, 92px);
    line-height: 0.98;
  }
  .copy__a,
  .copy__b {
    font-size: 18px;
    line-height: 1.7;
    font-weight: 400;
  }
  .copy__a {
    left: 6vw;
    top: 62%;
    max-width: 330px;
  }
  .copy__b {
    right: 6vw;
    top: 34%;
    max-width: 300px;
    text-align: right;
  }
  .copy__c {
    right: 6vw;
    bottom: 9%;
    max-width: 520px;
    text-align: right;
    font-size: clamp(26px, 2.4vw, 38px);
    line-height: 1.25;
  }

  /* Stacked (phone + tablet portrait): title on top, the rest grouped at the bottom. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px), (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .room__scrim {
      background: linear-gradient(180deg, rgb(10 7 5 / 0.75) 0%, rgb(10 7 5 / 0.35) 30%, rgb(10 7 5 / 0.55) 55%, rgb(10 7 5 / 0.9) 100%);
    }
    .copy {
      display: flex;
      flex-direction: column;
      padding: 76px 24px max(18vh, 120px);
    }
    .copy > * {
      position: static;
      max-width: none;
      text-align: left;
    }
    .copy__h {
      font-size: 40px;
      line-height: 1.02;
    }
    .copy__a {
      margin-top: auto;
    }
    .copy__a,
    .copy__b {
      font-size: 16px;
      line-height: 1.6;
    }
    .copy__b {
      margin-top: 16px;
    }
    .copy__c {
      margin-top: 22px;
      font-size: 24px;
      line-height: 1.3;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .copy {
      padding: 96px 48px max(16vh, 120px);
    }
    .copy__h {
      font-size: 60px;
    }
    .copy__a,
    .copy__b {
      font-size: 19px;
    }
    .copy__c {
      font-size: 30px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .copy {
      padding: 64px 20px max(12vh, 64px);
    }
    .copy__h {
      font-size: 32px;
    }
    .copy__a,
    .copy__b {
      font-size: 14px;
      line-height: 1.5;
    }
    .copy__c {
      font-size: 19px;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .copy__h {
      top: 10%;
      font-size: clamp(26px, 9vh, 48px);
    }
    .copy__a,
    .copy__b {
      font-size: 13px;
      line-height: 1.5;
      max-width: 34vw;
    }
    .copy__a {
      top: 52%;
    }
    .copy__b {
      top: 26%;
    }
    .copy__c {
      font-size: 17px;
      max-width: 40vw;
      bottom: 8%;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .copy {
      padding: 12vh 8vw max(16vh, 120px);
    }
    .copy__h {
      font-size: clamp(52px, 7.5vw, 76px);
    }
    .copy__a,
    .copy__b {
      font-size: clamp(18px, 2.4vw, 22px);
      line-height: 1.6;
    }
    .copy__b {
      margin-top: 18px;
    }
    .copy__c {
      margin-top: 26px;
      font-size: clamp(28px, 3.8vw, 38px);
    }
  }
</style>
