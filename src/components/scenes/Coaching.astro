---
// TODO(Natalie): sample copy (coaching, from her documents and email), awaiting her approval.
import NotesSvg from '../NotesSvg.astro';
---

<section id="coaching" class="scene coaching" data-tint="#120A05" data-tint-light="#F5F1E9" data-scene="coaching" aria-labelledby="coaching-title">
  <div class="stage">
    <div class="exit-dim exit-dim--dark" aria-hidden="true"></div>
    <div class="frame">
      <div class="layout">
        <div class="notes-box">
          <NotesSvg class="notes" />
        </div>
        <div class="text">
        <p class="label text__label" data-reveal="1">Coaching</p>
        <h2 id="coaching-title" class="display text__h" data-reveal="1">Soms helpt het om <em>samen te kijken.</em></h2>
        <p class="text__p" data-reveal="2">
          In een coachingsessie ga je met Natalie in gesprek over wat er speelt: in je hoofd, je lichaam, je relaties.
        </p>
        <p class="text__p" data-reveal="3">
          Niet om je te repareren, wel om te zien hoe alles samenhangt en wat je anders wilt. Apart te boeken, of samen met een
          soundroom-sessie.
        </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    background: var(--page);
  }
  /* Desktop: notes and text side by side, the pair centred in the screen. */
  .layout {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 4vw;
    padding: 0 var(--gutter);
  }
  /* Only a box on phones (the room between the navbar and the text); elsewhere a plain grid cell. */
  .notes-box {
    display: contents;
  }
  .stage :global(.notes) {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 7;
    max-height: 72%;
  }
  .text {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    color: var(--fg);
  }
  .text__label {
    color: var(--label);
  }
  .text__h {
    font-size: clamp(44px, 4.6vw, 80px);
    line-height: 1;
  }
  .text__h em {
    color: var(--accent);
  }
  .text__p {
    font-size: 17px;
    line-height: 1.75;
  }

  /* Phone: the drawing is wide, so it is scaled to its right part (loop, notes, beam)
     and the start of the copper line runs in from beyond the left edge. It is centred
     in the room between the navbar and the text. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .layout {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: 68px 0 6%;
    }
    .notes-box {
      display: block;
      position: relative;
      flex: 1;
      min-height: 0;
    }
    .stage :global(.notes) {
      position: absolute;
      max-height: none;
      aspect-ratio: auto;
      --w: 147vw;
      left: -42vw;
      width: var(--w);
      height: calc(var(--w) * 7 / 8);
      top: calc(50% - var(--w) * 7 / 16);
    }
    .stage :global(.notes [data-draw]) {
      stroke-width: 2.6;
    }
    .text {
      margin: 0 24px;
      max-width: none;
      gap: 20px;
    }
    .text__h {
      font-size: 40px;
    }
    .text__p {
      font-size: 16px;
      line-height: 1.65;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .text {
      margin: 0 48px;
    }
    .text__h {
      font-size: 52px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .layout {
      padding-top: 60px;
    }
    .stage :global(.notes) {
      --w: 124vw;
      left: -35vw;
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 30px;
    }
    .text__p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      gap: 12px;
    }
    .text__h {
      font-size: clamp(24px, 8vh, 40px);
    }
    .text__p {
      font-size: 13px;
      line-height: 1.5;
    }
  }
  /* Tablet portrait: the notes above the text, the two centred together. The drawing only
     fills the middle band of its box, so the empty top and bottom are cropped away. */
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: 3vh;
      padding: 0 var(--gutter);
    }
    .notes-box {
      display: contents;
    }
    .stage :global(.notes) {
      position: static;
      max-height: none;
      aspect-ratio: 8 / 7;
      width: 100%;
      height: auto;
      margin: -27% 0 -24%;
    }
    .text {
      margin: 0;
      max-width: none;
      gap: 22px;
    }
    .text__h {
      font-size: clamp(44px, 7vw, 68px);
    }
    .text__p {
      font-size: clamp(17px, 2.3vw, 21px);
      line-height: 1.65;
    }
  }
</style>
