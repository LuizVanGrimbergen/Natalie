---
// TODO(Natalie): sample copy from her notes and the article, awaiting her approval.
import { project } from '../../scripts/scenes/fold/geometry';
import { faceFill, faceSeam, hingeStroke } from '../../scripts/scenes/fold/shade';

// The closed dome as it ends in the build (scripts/scenes/shape.ts), for no JS and reduced motion.
const closed = project({ fold: 1, turn: 0.55, tilt: -0.45 });
const points = (list: [number, number][]) => list.map(([x, y]) => `${x.toFixed(4)},${y.toFixed(4)}`).join(' ');
---

<section id="ruimte" class="scene shape" data-tint="#120A05" data-tint-light="#F5F1E9" data-scene="shape" aria-labelledby="shape-title">
  <div class="stage">
    <div class="exit-dim exit-dim--dark" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true" data-shape-glow></div>
    <div class="frame">
      <div class="dome" aria-hidden="true" data-dome>
        <canvas class="dome__canvas" data-fold></canvas>
        <svg class="dome__still" viewBox="-0.5 -0.5 1 1" focusable="false">
          {
            closed.faces.map((face) => (
              <polygon points={points(face.points)} fill={faceFill(face)} stroke={faceSeam(face)} stroke-width="1.6" vector-effect="non-scaling-stroke" />
            ))
          }
          {
            closed.hinges.map((hinge) => (
              <line
                x1={hinge.from[0]}
                y1={hinge.from[1]}
                x2={hinge.to[0]}
                y2={hinge.to[1]}
                stroke={hingeStroke(hinge)}
                stroke-width="1"
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </svg>
      </div>
      <div class="text" data-shape-text>
        <p class="label text__label" data-reveal="1">De ruimte</p>
        <h2 id="shape-title" class="display text__h" data-reveal="1">Een ruimte die <em>mee luistert.</em></h2>
        <p class="text__p" data-reveal="2">
          Dertig ruiten vouwen samen tot één koepel. Elke hoek en elk vlak bepaalt hoe het geluid beweegt, weerkaatst en uitdooft.
        </p>
        <p class="display text__c" data-reveal="3"><em>Stilte is hier geen leegte. Het is structuur.</em></p>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    /* Width of the text column on desktop; the dome starts just after it. */
    --text-w: min(500px, 36vw);
    background: var(--page);
    color: var(--fg);
  }
  /* Warm light behind the dome, fading to flat wood well before the screen edges. */
  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 40% 42% at 68% 50%, rgb(156 85 48 / 0.18), rgb(156 85 48 / 0) 100%);
    pointer-events: none;
  }
  .dome {
    position: absolute;
    /* From just after the text to near the right edge (closer in on big screens). */
    left: calc(var(--gutter) + var(--text-w) + 2vw);
    right: calc(var(--gutter) - 3vw);
    top: 6%;
    height: 88%;
  }
  .dome__canvas,
  .dome__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dome__canvas {
    display: none;
  }
  :global(html.motion) .dome__canvas {
    display: block;
  }
  :global(html.motion) .dome__still {
    display: none;
  }
  .text {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: var(--text-w);
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .text__label {
    color: var(--label);
  }
  .text__h {
    font-size: clamp(44px, 4.6vw, 80px);
    line-height: 1;
  }
  .text__h em,
  .text__c {
    color: var(--accent);
  }
  .text__p {
    font-size: 17px;
    line-height: 1.75;
  }
  .text__c {
    font-size: clamp(24px, 2.2vw, 34px);
    line-height: 1.25;
  }

  /* Stacked (phone): the dome on top, the text grouped at the bottom. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .glow {
      background: radial-gradient(ellipse 70% 32% at 50% 30%, rgb(156 85 48 / 0.18), rgb(156 85 48 / 0) 100%);
    }
    /* A column: the dome fills the room between the navbar and the text, centred in it. */
    .frame {
      display: flex;
      flex-direction: column;
      padding: 68px 24px 1svh;
    }
    .dome {
      position: relative;
      inset: auto;
      flex: 1;
      min-height: 0;
      height: auto;
      margin: 0 -24px 16px;
    }
    .text {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      width: auto;
      gap: 18px;
    }
    .text__h {
      font-size: 40px;
    }
    .text__p {
      font-size: 16px;
      line-height: 1.65;
    }
    .text__c {
      font-size: 22px;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .frame {
      padding-inline: 48px;
    }
    .dome {
      margin-inline: -48px;
    }
    .text__h {
      font-size: 52px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .frame {
      padding-top: 60px;
    }
    .dome {
      margin-bottom: 10px;
    }
    .text {
      gap: 12px;
    }
    .text__h {
      font-size: 30px;
    }
    .text__p {
      font-size: 14px;
      line-height: 1.5;
    }
    .text__c {
      font-size: 18px;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      gap: 10px;
    }
    .text__h {
      font-size: clamp(24px, 8vh, 40px);
    }
    .text__p {
      font-size: 13px;
      line-height: 1.5;
    }
    .text__c {
      font-size: 17px;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .glow {
      background: radial-gradient(ellipse 60% 30% at 50% 30%, rgb(156 85 48 / 0.18), rgb(156 85 48 / 0) 100%);
    }
    .frame {
      display: block;
      padding: 0;
    }
    .dome {
      position: absolute;
      left: 6vw;
      right: 6vw;
      top: 7%;
      height: 44%;
      margin: 0;
    }
    .text {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      top: 55%;
      bottom: auto;
      transform: none;
      width: auto;
      gap: 22px;
    }
    .text__h {
      font-size: clamp(44px, 7vw, 68px);
    }
    .text__p {
      font-size: clamp(17px, 2.3vw, 21px);
      line-height: 1.65;
    }
    .text__c {
      font-size: clamp(24px, 3.4vw, 34px);
    }
  }
</style>
