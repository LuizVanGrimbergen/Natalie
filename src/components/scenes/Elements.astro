---
// TODO(Natalie): sample copy from her notes (the three elements of a session), awaiting her approval.
const elements = [
  {
    name: 'De persoon',
    text: 'Jij, zoals je binnenkomt: je lichaam, je adem, de ruis in je hoofd, je vermoeidheid of alertheid.',
  },
  {
    name: 'Het geluidsveld',
    text: 'De muziek zelf: klank, ritme, frequenties, stilte, en hoe de ruimte ze draagt.',
  },
  {
    name: 'De koppeling',
    text: 'Wat er tussen jou en het geluid ontstaat: een adem die vertraagt, schouders die zakken, beelden, rust.',
  },
];
---

<section class="scene elements" style="z-index: 4" data-tint="#120A05" data-tint-light="#F5F1E9" data-scene="elements" aria-labelledby="elements-title">
  <div class="stage">
    <div class="exit-dim exit-dim--dark" aria-hidden="true"></div>
    <div class="frame">
      <div class="layout">
        <div class="intro">
          <h2 id="elements-title" class="display intro__h" data-reveal="1">Wat er gebeurt <em>tussen jou en het geluid.</em></h2>
          <p class="intro__p" data-reveal="1">
            Je hoeft niets te doen. Je lichaam mag loslaten, tot rust komen en weer opladen. Drie dingen spelen daarin samen.
          </p>
        </div>
        <ol class="list">
          {
            elements.map((element, i) => (
              <li class="item" data-reveal={i + 2}>
                <h3 class="display item__name">{element.name}</h3>
                <p class="item__text">{element.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    background: var(--page);
    color: var(--fg);
  }
  .layout {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(40px, 9vh, 96px);
    padding: 0 6vw;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }
  .intro__h {
    font-size: clamp(44px, 4.6vw, 80px);
    line-height: 1;
  }
  .intro__h em {
    color: var(--accent);
  }
  .intro__p {
    max-width: 560px;
    font-size: 17px;
    line-height: 1.75;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4vw;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Text only: a fine copper line above each element, nothing else. */
  .item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .item__name {
    font-size: clamp(26px, 2.2vw, 36px);
    line-height: 1.1;
  }
  .item__text {
    max-width: 360px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--fg-soft);
  }

  /* Stacked (phone): title on top, the three under each other. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .layout {
      justify-content: space-between;
      gap: 24px;
      padding: 76px 24px 24px;
    }
    .intro {
      gap: 12px;
    }
    .intro__h {
      font-size: 38px;
    }
    .intro__p {
      font-size: 16px;
      line-height: 1.6;
    }
    .list {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .item {
      gap: 4px;
      padding-top: 14px;
    }
    .item__name {
      font-size: 24px;
    }
    .item__text {
      font-size: 15px;
      line-height: 1.55;
      max-width: none;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .layout {
      padding: 96px 48px 32px;
    }
    .intro__h {
      font-size: 52px;
    }
    .item__text {
      font-size: 17px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .layout {
      padding: 56px 20px 12px;
      gap: 14px;
    }
    .intro__h {
      font-size: 28px;
    }
    .intro__p {
      font-size: 14px;
    }
    .list {
      gap: 12px;
    }
    .item {
      padding-top: 10px;
    }
    .item__name {
      font-size: 20px;
    }
    .item__text {
      font-size: 13px;
      line-height: 1.45;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .layout {
      gap: 5vh;
    }
    .intro {
      gap: 8px;
    }
    .intro__h {
      font-size: clamp(24px, 8vh, 40px);
    }
    .intro__p {
      font-size: 13px;
    }
    .item {
      gap: 6px;
      padding-top: 10px;
    }
    .item__name {
      font-size: clamp(18px, 5vh, 24px);
    }
    .item__text {
      font-size: 13px;
      line-height: 1.5;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .layout {
      justify-content: center;
      gap: 7vh;
      padding: 10vh 10vw 4vh;
    }
    .intro__h {
      font-size: clamp(44px, 7vw, 68px);
    }
    .intro__p {
      font-size: clamp(17px, 2.3vw, 21px);
    }
    .list {
      grid-template-columns: 1fr;
      gap: 4vh;
    }
    .item__name {
      font-size: clamp(28px, 4vw, 38px);
    }
    .item__text {
      font-size: clamp(17px, 2.3vw, 21px);
      max-width: none;
    }
  }
</style>
