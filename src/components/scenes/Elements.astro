---
// TODO(Natalie): sample copy from her notes, awaiting her approval.
import ElementsList from './ElementsList.astro';

/* Scene 04: the title on its own screen, then the three elements together (ElementsList.astro); the title shrinks into the head of that screen (gather.ts). */
---

<section class="scene elements" data-tint="#120A05" data-tint-light="#F5F1E9" data-scene="elements" aria-labelledby="elements-title">
  <div class="stage">
    <div class="exit-dim exit-dim--dark" aria-hidden="true"></div>
    <div class="frame">
      <div class="intro">
        <div data-gather-line>
          <p class="label intro__label" data-reveal="1">Hoe verloopt een sessie?</p>
        </div>
        <div data-gather-title>
          <h2 id="elements-title" class="display intro__h" data-reveal="1">Wat muziek <em>met je kan doen.</em></h2>
        </div>
        <div data-gather-line>
          <p class="intro__p" data-reveal="2">
            Je ligt in de soundroom en luistert, vijftig minuten lang. Je hoeft niets te doen of te bereiken: wat je hoort en wat het met
            je doet, is voor iedereen anders. Drie dingen spelen daarin samen.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<ElementsList />

<style>
  .stage {
    background: var(--page);
    color: var(--fg);
  }
  .intro {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 920px;
  }
  .intro__h {
    font-size: clamp(48px, 5.6vw, 96px);
    line-height: 1;
  }
  .intro__label {
    color: var(--label);
  }
  .intro__h em {
    color: var(--accent);
  }
  .intro__p {
    max-width: 560px;
    font-size: 19px;
    line-height: 1.7;
    color: var(--fg-soft);
  }

  /* Stacked (phone): the words a little above the middle. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .intro {
      left: 24px;
      right: 24px;
      top: 44%;
      gap: 20px;
    }
    .intro__h {
      font-size: 42px;
    }
    .intro__p {
      font-size: 17px;
      line-height: 1.65;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .intro {
      left: 48px;
      right: 48px;
    }
    .intro__h {
      font-size: 56px;
    }
    .intro__p {
      font-size: 19px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .intro {
      gap: 14px;
    }
    .intro__h {
      font-size: 34px;
    }
    .intro__p {
      font-size: 15px;
      line-height: 1.55;
    }
  }
  /* Phone landscape: compact, vh-based. */
  @media (min-width: 560px) and (max-height: 520px) {
    .intro {
      gap: 3vh;
    }
    .intro__h {
      font-size: clamp(28px, 10vh, 48px);
    }
    .intro__p {
      font-size: 14px;
      line-height: 1.55;
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .intro {
      left: var(--gutter);
      right: var(--gutter);
    }
    .intro__h {
      font-size: clamp(52px, 7.6vw, 76px);
    }
    .intro__p {
      font-size: clamp(19px, 2.6vw, 23px);
    }
  }
</style>
