---
import { Picture } from 'astro:assets';
import chair from '../../assets/chair.avif';
import CtaLink from '../CtaLink.astro';
---

<section id="invitation" class="scene invitation" style="z-index: 5" data-tint="#F5F1E9" data-scene="invitation" data-enter="light" aria-labelledby="invitation-title">
  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <div class="frame">
      <!-- The invitation as a poster on the ivory wall: the forest on top, the words printed below. -->
      <div class="wall">
      <article class="poster" data-poster>
        <div class="poster__photo" aria-hidden="true">
          <Picture class="poster__img" src={chair} formats={['avif', 'webp']} fallbackFormat="jpg" alt="" widths={[600, 1000, 1400]} sizes="(max-width: 820px) 100vw, 50vw" data-poster-photo />
        </div>
        <div class="poster__body">
          <h2 id="invitation-title" class="display poster__h" data-reveal="1">Misschien is dit iets <em>voor jou.</em></h2>
          <p class="poster__p" data-reveal="2">
            Je hoeft niet precies te weten wat je zoekt. Soms is even tijd voor jezelf al een mooi begin: in de soundroom, of in een
            gesprek met Natalie. Ervaar het op jouw manier.
          </p>
          <div data-reveal="3">
            <CtaLink href="/booking">Ontdek de sessies</CtaLink>
          </div>
        </div>
      </article>
      </div>
    </div>
  </div>
</section>

<style>
  /* Warm in the middle, plain ivory at the top and bottom edges, where Safari's bars meet the page. */
  .stage {
    background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-warm) 35%, var(--color-ivory-warm-2) 60%, var(--color-ivory) 100%);
    color: var(--color-bronze-900);
  }
  .glow {
    position: absolute;
    left: calc(50% - 30vw);
    top: -6%;
    width: 60vw;
    height: 112%;
    background: radial-gradient(ellipse 40% 50% at 50% 55%, rgb(200 143 128 / 0.32), rgb(245 241 233 / 0) 70%);
    pointer-events: none;
  }
  /* Sizes inside follow the poster itself (container units), so it reads the same at every screen size. */
  .wall {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 56px 16px 72px;
  }
  .poster {
    height: min(100%, 920px);
    aspect-ratio: 0.72;
    max-width: calc(100vw - 2 * var(--gutter));
    container-type: size;
    display: grid;
    grid-template-rows: 54% 1fr;
    background: #fbf8f2;
    box-shadow:
      0 1px 2px rgb(62 52 44 / 0.1),
      0 30px 60px -24px rgb(62 52 44 / 0.3);
  }
  .poster__photo {
    overflow: hidden;
  }
  .poster :global(.poster__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 55%;
  }
  .poster__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3.2cqh;
    padding: 0 8cqw;
  }
  .poster__h {
    font-size: min(8.6cqh, 12cqw);
    line-height: 0.98;
  }
  .poster__h em {
    color: var(--color-copper-700);
  }
  .poster__p {
    font-size: max(14px, min(2.1cqh, 3.6cqw));
    line-height: 1.65;
    color: var(--color-body-on-ivory);
  }

  /* Phones: the poster fills the screen, minus a paper edge. */
  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    .wall {
      padding: 64px 36px 76px;
    }
    .poster {
      height: 100%;
      width: 100%;
      max-width: none;
      aspect-ratio: auto;
      grid-template-rows: 46% 1fr;
    }
    .poster__h {
      font-size: min(6.2cqh, 11cqw);
    }
  }
  /* Short phones (iPhone SE): less forest, so the words and the button stay on the poster. */
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .wall {
      padding: 56px 32px 64px;
    }
    .poster {
      grid-template-rows: 36% 1fr;
    }
    .poster__body {
      gap: 2.6cqh;
    }
    .poster__p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  /* Phone landscape: the poster lies down, forest left, words right. */
  @media (min-width: 560px) and (max-height: 520px) {
    .wall {
      padding: 24px 64px;
    }
    .poster {
      height: 100%;
      aspect-ratio: 1.9;
      grid-template-rows: none;
      grid-template-columns: 45% 1fr;
    }
    .poster__body {
      padding: 0 6cqw;
      gap: 4cqh;
    }
    .poster__h {
      font-size: 13cqh;
    }
    .poster__p {
      font-size: 13px;
      line-height: 1.5;
    }
  }
</style>
