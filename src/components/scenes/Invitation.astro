---
import { Picture } from 'astro:assets';
import chair from '../../assets/chair.avif';
import dome from '../../assets/hero.avif';
import CtaLink from '../CtaLink.astro';
---

<section id="invitation" class="scene invitation" style="z-index: 5" data-tint="#F5F1E9" data-scene="invitation" data-enter="light" aria-labelledby="invitation-title">
  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <div class="frame">
      <div class="grid">
        <div class="text">
          <h2 id="invitation-title" class="display text__h" data-reveal="1">Misschien is dit iets <em>voor jou.</em></h2>
          <p class="text__p" data-reveal="2">
            Je hoeft niet precies te weten wat je zoekt. Soms is even tijd voor jezelf al een mooi begin: in de soundroom, of in een
            gesprek met Natalie. Ervaar het op jouw manier.
          </p>
          <div data-reveal="3">
            <CtaLink href="/booking">Ontdek de sessies</CtaLink>
          </div>
        </div>
        <!-- An invitation you receive: a postcard on a second one, with a stamp of the dome. -->
        <figure class="card" aria-hidden="true">
          <div class="card__under" data-card-under></div>
          <div class="card__paper" data-card>
            <Picture class="card__photo" src={chair} formats={['avif', 'webp']} fallbackFormat="jpg" alt="" widths={[420, 840]} sizes="420px" />
            <p class="card__caption">Schoten</p>
            <span class="card__stamp">
              <Picture class="card__stamp-img" src={dome} formats={['avif', 'webp']} fallbackFormat="jpg" alt="" widths={[160]} sizes="80px" />
            </span>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  /* Warm in the middle, plain ivory at the top and bottom edges, where Safari's bars meet the page. */
  .stage {
    background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-warm) 35%, var(--color-ivory-warm-2) 60%, var(--color-ivory) 100%);
    color: var(--color-bronze-900);
  }
  .glow {
    position: absolute;
    left: calc(50% - 30vw);
    top: -6%;
    width: 60vw;
    height: 112%;
    background: radial-gradient(ellipse 40% 50% at 50% 55%, rgb(200 143 128 / 0.32), rgb(245 241 233 / 0) 70%);
    pointer-events: none;
  }
  .grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6vw;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .text__h {
    font-size: clamp(40px, 5.2vw, 96px);
    line-height: 0.98;
  }
  .text__h em {
    color: var(--color-copper-700);
  }
  .text__p {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-body-on-ivory);
  }
  .card {
    position: relative;
    height: min(74%, 620px);
    aspect-ratio: 0.74;
    justify-self: center;
    margin: 0;
  }
  .card__under,
  .card__paper {
    position: absolute;
    inset: 0;
    background: #fbf8f2;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgb(62 52 44 / 0.12),
      0 18px 40px -12px rgb(62 52 44 / 0.28);
  }
  .card__under {
    transform: rotate(5deg) translate(4%, 1%);
    background: #f3ece2;
  }
  /* Photo on top, a wide paper edge below for the place and the stamp. */
  .card__paper {
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 5.5% 5.5% 0;
    transform: rotate(-3deg);
  }
  .card :global(.card__photo) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: 58% 50%;
  }
  .card__caption {
    margin: 0;
    padding: 0.5em 0 0.7em;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1;
    color: var(--color-copper-700);
  }
  /* A postage stamp: solid inside, a row of holes only along its edge, slightly askew. */
  .card__stamp {
    position: absolute;
    right: 5%;
    bottom: 2.6%;
    width: 17%;
    aspect-ratio: 4 / 5;
    padding: 5px;
    background: #fbf8f2;
    transform: rotate(4deg);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      radial-gradient(circle 2.6px, transparent 96%, #000) -4px -4px / 8px 8px round;
    mask:
      linear-gradient(#000 0 0) content-box,
      radial-gradient(circle 2.6px, transparent 96%, #000) -4px -4px / 8px 8px round;
  }
  .card :global(.card__stamp-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 45%;
    border: 2px solid #fbf8f2;
    outline: 1px solid rgb(156 85 48 / 0.4);
    outline-offset: -2px;
  }

  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    /* The card takes all the height the text leaves free. */
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 28px;
      padding: 72px 24px 40px;
    }
    .text {
      gap: 18px;
    }
    .text__h {
      font-size: 44px;
    }
    .text__p {
      font-size: 16px;
      line-height: 1.6;
    }
    .card {
      height: 100%;
      max-height: 480px;
      max-width: 100%;
      align-self: end;
      justify-self: center;
      order: -1;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .grid {
      padding: 96px 48px 48px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .grid {
      padding: 56px 20px 28px;
      gap: 16px;
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 32px;
    }
    .text__p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      gap: 12px;
    }
    .text__h {
      font-size: clamp(26px, 9vh, 48px);
    }
    .text__p {
      font-size: 13px;
      line-height: 1.5;
    }
    .card {
      height: calc(100svh - 112px);
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      align-content: center;
      gap: 32px;
      padding: 10vh var(--gutter) 8vh;
    }
    .card {
      height: min(36vh, 440px);
      max-height: none;
      order: -1;
      justify-self: start;
    }
    .text__h {
      font-size: clamp(48px, 7vw, 72px);
    }
    .text__p {
      font-size: clamp(18px, 2.3vw, 21px);
      max-width: none;
    }
  }
</style>
