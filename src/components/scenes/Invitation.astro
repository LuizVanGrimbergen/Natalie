---
import { Picture } from 'astro:assets';
import door from '../../assets/door.avif';
import CtaLink from '../CtaLink.astro';
---

<section id="invitation" class="scene invitation" data-tint="#120A05" data-tint-light="#F5F1E9" data-scene="invitation" aria-labelledby="invitation-title">
  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <div class="frame">
      <div class="grid" data-footer-shift>
        <div class="text" data-footer-clear>
          <h2 id="invitation-title" class="display text__h" data-reveal="1">Misschien is dit iets <em>voor jou.</em></h2>
          <p class="text__p" data-reveal="2">
            Sommige ervaringen laten zich moeilijk in woorden vatten. Je ontdekt pas wat ze voor jou betekenen wanneer je ervoor
            openstaat.
          </p>
          <div data-reveal="3">
            <CtaLink href="/booking">Afspraak maken</CtaLink>
          </div>
        </div>
        <figure class="door" aria-hidden="true" data-unveil>
          <Picture class="door__img" src={door} formats={['avif', 'webp']} fallbackFormat="jpg" alt="" widths={[330]} sizes="330px" />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  /* Flat wood at the top and bottom edges, where Safari's bars meet the page; the glow sits in the middle. */
  .stage {
    background: var(--page);
    color: var(--fg);
  }
  /* When the footer comes up, the content may move up to stay clear of it; it then
     fades out softly at the top, so the top edge (and Safari's bar) stays flat wood. */
  :global(html.motion) .frame {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 40px);
    mask-image: linear-gradient(to bottom, transparent, #000 40px);
  }
  .glow {
    position: absolute;
    left: calc(50% - 30vw);
    top: -6%;
    width: 60vw;
    height: 112%;
    background: radial-gradient(ellipse 40% 50% at 50% 55%, rgb(200 143 128 / 0.16), rgb(200 143 128 / 0) 70%);
    pointer-events: none;
  }
  .grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6vw;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .text__h {
    font-size: clamp(40px, 5.2vw, 96px);
    line-height: 0.98;
  }
  .text__h em {
    color: var(--accent);
  }
  .text__p {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.7;
  }
  .door {
    height: min(68%, 560px);
    aspect-ratio: 330 / 490;
    justify-self: center;
    will-change: clip-path, transform;
  }
  .door :global(.door__img) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    border-radius: 999px 999px 2px 2px;
    box-shadow: 0 40px 120px 10px rgb(212 154 114 / 0.22);
  }

  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    /* The door takes all the height the text leaves free. */
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 28px;
      padding: 72px 24px 40px;
    }
    .text {
      gap: 18px;
    }
    .text__h {
      font-size: 44px;
    }
    .text__p {
      font-size: 16px;
      line-height: 1.6;
    }
    .door {
      height: 100%;
      max-height: 480px;
      max-width: 100%;
      align-self: end;
      justify-self: center;
      order: -1;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .grid {
      padding: 96px 48px 48px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .grid {
      padding: 56px 20px 28px;
      gap: 16px;
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 32px;
    }
    .text__p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      gap: 12px;
    }
    .text__h {
      font-size: clamp(26px, 9vh, 48px);
    }
    .text__p {
      font-size: 13px;
      line-height: 1.5;
    }
    .door {
      height: calc(100svh - 112px);
    }
  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      align-content: center;
      gap: 32px;
      padding: 10vh var(--gutter) 8vh;
    }
    .door {
      height: min(32vh, 400px);
      max-height: none;
      order: -1;
      justify-self: start;
    }
    .text__h {
      font-size: clamp(48px, 7vw, 72px);
    }
    .text__p {
      font-size: clamp(18px, 2.3vw, 21px);
      max-width: none;
    }
  }
</style>
