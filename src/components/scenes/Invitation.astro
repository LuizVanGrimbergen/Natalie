---
import { Picture } from 'astro:assets';
import chair from '../../assets/chair.avif';
import CtaLink from '../CtaLink.astro';
---

<section id="invitation" class="scene invitation" style="z-index: 5" data-tint="#F5F1E9" data-scene="invitation" data-enter="light" aria-labelledby="invitation-title">
  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <!-- The forest grows into the page: no frame, its edges dissolve into the ivory. -->
    <figure class="forest" aria-hidden="true">
      <Picture class="forest__img" src={chair} formats={['avif', 'webp']} fallbackFormat="jpg" alt="" widths={[720, 1200, 1600]} sizes="(max-width: 820px) 100vw, 60vw" data-forest />
    </figure>
    <div class="frame">
      <div class="grid">
        <div class="text">
          <h2 id="invitation-title" class="display text__h" data-reveal="1">Misschien is dit iets <em>voor jou.</em></h2>
          <p class="text__p" data-reveal="2">
            Je hoeft niet precies te weten wat je zoekt. Soms is even tijd voor jezelf al een mooi begin: in de soundroom, of in een
            gesprek met Natalie. Ervaar het op jouw manier.
          </p>
          <div data-reveal="3">
            <CtaLink href="/booking">Ontdek de sessies</CtaLink>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Warm in the middle, plain ivory at the top and bottom edges, where Safari's bars meet the page. */
  .stage {
    background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-warm) 35%, var(--color-ivory-warm-2) 60%, var(--color-ivory) 100%);
    color: var(--color-bronze-900);
  }
  .glow {
    position: absolute;
    left: calc(50% - 30vw);
    top: -6%;
    width: 60vw;
    height: 112%;
    background: radial-gradient(ellipse 40% 50% at 50% 55%, rgb(200 143 128 / 0.32), rgb(245 241 233 / 0) 70%);
    pointer-events: none;
  }
  .grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6vw;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .text__h {
    font-size: clamp(40px, 5.2vw, 96px);
    line-height: 0.98;
  }
  .text__h em {
    color: var(--color-copper-700);
  }
  .text__p {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-body-on-ivory);
  }
  /* Plain ivory at the top and bottom edges stays (Safari's bars), and at the right edge, so the dots stay readable. */
  .forest {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 60%;
    margin: 0;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 45%, #000 84%, transparent 97%), linear-gradient(to bottom, transparent 4%, #000 26%, #000 74%, transparent 96%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 45%, #000 84%, transparent 97%), linear-gradient(to bottom, transparent 4%, #000 26%, #000 74%, transparent 96%);
    mask-composite: intersect;
    pointer-events: none;
  }
  .forest :global(.forest__img) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 58% 50%;
  }
  .text {
    position: relative;
  }

  @media (max-width: 559px), (max-width: 820px) and (min-height: 521px) {
    /* The forest fills the top, the text sits below. */
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 28px;
      padding: 72px 24px 40px;
    }
    .text {
      gap: 18px;
    }
    .text__h {
      font-size: 44px;
    }
    .text__p {
      font-size: 16px;
      line-height: 1.6;
    }
    .forest {
      left: 0;
      width: 100%;
      bottom: auto;
      height: 62%;
      -webkit-mask-image: linear-gradient(to right, #000 68%, transparent 90%), linear-gradient(to bottom, transparent 2%, #000 22%, #000 62%, transparent);
      mask-image: linear-gradient(to right, #000 68%, transparent 90%), linear-gradient(to bottom, transparent 2%, #000 22%, #000 62%, transparent);
    }
    .text {
      grid-row: 2;
    }
  }
  @media (min-width: 600px) and (max-width: 820px) and (min-height: 521px) {
    .grid {
      padding: 96px 48px 48px;
    }
  }
  @media (max-width: 559px) and (max-height: 700px), (max-width: 820px) and (min-height: 521px) and (max-height: 700px) {
    .grid {
      padding: 56px 20px 28px;
      gap: 16px;
    }
    .text {
      gap: 14px;
    }
    .text__h {
      font-size: 32px;
    }
    .text__p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  @media (min-width: 560px) and (max-height: 520px) {
    .text {
      gap: 12px;
    }
    .text__h {
      font-size: clamp(26px, 9vh, 48px);
    }
    .text__p {
      font-size: 13px;
      line-height: 1.5;
    }

  }
  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      align-content: center;
      gap: 32px;
      padding: 10vh var(--gutter) 8vh;
    }
    .grid {
      align-content: end;
    }
    .forest {
      left: 0;
      width: 100%;
      bottom: auto;
      height: 60%;
      -webkit-mask-image: linear-gradient(to right, #000 68%, transparent 90%), linear-gradient(to bottom, transparent 2%, #000 22%, #000 62%, transparent);
      mask-image: linear-gradient(to right, #000 68%, transparent 90%), linear-gradient(to bottom, transparent 2%, #000 22%, #000 62%, transparent);
    }
    .text__h {
      font-size: clamp(48px, 7vw, 72px);
    }
    .text__p {
      font-size: clamp(18px, 2.3vw, 21px);
      max-width: none;
    }
  }
</style>
