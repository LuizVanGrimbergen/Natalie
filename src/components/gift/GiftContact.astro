---
// Contact at the end of the gift page: Natalie's name, e-mail, WhatsApp and Instagram, then her registered office and
// enterprise number (a Belgian self-employed person shows them; never her home address).
import { business, email, instagram, phone, whatsapp } from '../../data/contact';
---

<section class="contact" aria-labelledby="gift-contact-title">
  <h2 id="gift-contact-title" class="label contact__label">Contact</h2>
  <p class="contact__name">{business.name}</p>
  <a class="contact__link" href={`mailto:${email}`}>{email}</a>
  <a class="contact__link" href={whatsapp()} target="_blank" rel="noopener">WhatsApp {phone}</a>
  <a class="contact__link" href={instagram.url} target="_blank" rel="noopener">Instagram @{instagram.handle}</a>
  {business.seat && <p class="contact__legal">{business.seat}</p>}
  {business.enterpriseNumber && <p class="contact__legal">Ondernemingsnummer {business.enterpriseNumber}</p>}
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding-top: 40px;
    border-top: 1px solid rgb(156 85 48 / 0.2);
  }
  .contact__label {
    margin: 0 0 14px;
    color: var(--color-muted);
  }
  .contact__name {
    margin-bottom: 4px;
    font-size: 17px;
    font-weight: 500;
    color: var(--color-bronze-900);
  }
  .contact__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    color: var(--color-bronze-900);
    text-decoration: underline;
    text-decoration-color: rgb(156 85 48 / 0.4);
    text-underline-offset: 5px;
    transition: text-decoration-color 0.3s ease;
  }
  .contact__legal {
    font-size: 14px;
    line-height: 1.7;
    font-variant-numeric: lining-nums;
    color: var(--color-muted);
  }
  .contact__legal:first-of-type {
    margin-top: 10px;
  }
  @media (hover: hover) {
    .contact__link:hover {
      text-decoration-color: var(--color-copper-700);
    }
  }
</style>
