---
import { getImage } from 'astro:assets';
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/figtree/latin-300.css';
import '@fontsource/figtree/latin-400.css';
import '@fontsource/figtree/latin-500.css';
import '../styles/global.css';
import hero from '../assets/hero.avif';

interface Props {
  title: string;
  description: string;
  /** Story page: opt into the pinned, scroll-driven scenes (html.motion). */
  story?: boolean;
}

const { title, description, story = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: hero, width: 1200, height: 630, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#12100D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      story && (
        <script is:inline>
          // Motion is opt-in: without JS or with reduced motion the page stays a plain, readable flow.
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('motion');
            // Safety net: if the scene script never arrives, fall back to the static composition.
            setTimeout(function () {
              if (!window.__scenesReady) document.documentElement.classList.remove('motion');
            }, 6000);
          }
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
