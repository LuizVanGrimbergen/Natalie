---
import { getImage } from 'astro:assets';
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/figtree/latin-300.css';
import '@fontsource/figtree/latin-400.css';
import '@fontsource/figtree/latin-500.css';
import '../styles/global.css';
import hero from '../assets/hero.avif';
import type { ImageMetadata } from 'astro';
import { graph, SITE_NAME } from '../data/schema';
// The two faces every page needs first (titles, body text): preloaded, so the text doesn't swap late.
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import bodyFont from '@fontsource/figtree/files/figtree-latin-300-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Story page: opt into the pinned, scroll-driven scenes (html.motion). */
  story?: boolean;
  /** Color of the browser bars and overscroll area (Safari tints from the page background). */
  tint?: string;
  /** The picture shown when the page is shared (default: the hero, the room in the forest at dusk). */
  image?: ImageMetadata;
  /** Keep the page out of search results (e.g. the thank-you page after paying for a voucher). */
  noindex?: boolean;
  imageAlt?: string;
  /** schema.org type of the page (WebPage, AboutPage, …). */
  pageType?: string;
}

const {
  title,
  description,
  story = false,
  tint = '#12100D',
  image = hero,
  imageAlt = 'Het geometrische ruimteschip van hout tussen de bomen in het bos',
  pageType,
} = Astro.props;
// Pages are built as files (about.html), served without a trailing slash: the canonical says the same.
const canonical = new URL(Astro.url.pathname.replace(/(index)?(\.html)?\/?$/, '') || '/', Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
// A data block, not a script: the Content-Security-Policy (script-src 'self') doesn't apply to it.
const jsonLd = JSON.stringify(graph(Astro.site!, { url: canonical, title, description, image: ogUrl, type: pageType }));
---

<!doctype html>
<html lang="nl" style={`--tint: ${tint}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={Astro.props.noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <!-- Google Search Console: proves the site is ours (the file in public/ does the same). -->
    <meta name="google-site-verification" content="CWKjNy5_3esZoycByWI2MNYXtl50oiFb87Qs9OZEhkk" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={tint} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- A plain-text summary of the site for AI assistants (llmstxt.org). -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    {
      // A file, not inline, so the Content-Security-Policy can forbid inline scripts.
      story && <script is:inline src="/motion.js"></script>
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
